     pub(crate) fn start(&mut self) {
+        // hazync#119: the checksum INPUTS were proved identical between a failing and a passing
+        // draw -- same transactions, same coefficients, none out of range. So the divergence is in
+        // the accumulator itself. A zero here is the kind of measure-zero event that would be rare,
+        // knife-edge in z, and capable of breaking a constraint.
+        if std::env::var("HAZYNC_119_WATCH_ZCHECK").is_ok() {
+            let z = self.zcheck;
+            if z == ExtVal::ZERO {
+                eprintln!("[#119-ZCHECK] ZERO accumulator at start()");
+            }
+            eprintln!("[#119-ZCHECK] start zcheck={:?}", z.elems());
+        }
         self.zcheck *= self.powers[16];
     }
 
     pub(crate) fn clear(&mut self) {
+        if std::env::var("HAZYNC_119_WATCH_ZCHECK").is_ok() {
+            eprintln!("[#119-ZCHECK] clear, was={:?}", self.zcheck.elems());
+        }
         self.zcheck = ExtVal::ZERO;
     }
 
