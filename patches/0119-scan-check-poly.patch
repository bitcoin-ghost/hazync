+/// hazync#119: evaluate samples on mu_M at an arbitrary point, barycentric.
+///     f(zp) = ((zp^M - 1)/M) * sum_j  f_j * w^j / (zp - w^j)
+#[cfg(not(target_os = "zkvm"))]
+fn hazync_119_bary<E: ExtElem>(samples: &[E], w: E::SubElem, zp: E) -> E
+where
+    E: Send + Sync,
+    E::SubElem: Send + Sync,
+{
+    use rayon::prelude::*;
+    let m = samples.len();
+    let acc = samples
+        .par_iter()
+        .enumerate()
+        .map(|(j, fj)| {
+            let wj = w.pow(j);
+            *fj * E::from_subfield(&wj) * (zp - E::from_subfield(&wj)).inv()
+        })
+        .reduce(|| E::ZERO, |a, b| a + b);
+    acc * (zp.pow(m) - E::ONE) * E::from_subfield(&E::SubElem::from_u64(m as u64).inv())
+}
