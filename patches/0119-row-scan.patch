+/// hazync#119: report the trace rows at which a constraint is violated.
+///
+/// ⛔ The obvious approach does not work, and the reason is worth recording. `eval_check` evaluates
+/// on the extended coset and divides by the vanishing polynomial, so it is non-zero everywhere by
+/// construction — a scan of it reported 2,097,152 non-zero entries of 2,097,152 in **both** a
+/// failing and a passing run. Evaluating `poly_fp` at rate 1 does not work either: the vanishing
+/// polynomial is `(3x)^n - 1`, so risc0's trace domain is `(1/3)·μ_n`, not `μ_n`, and `poly_fp`
+/// derives `x` internally from `(cycle, domain)` with no way to pass an arbitrary point. That scan
+/// reported every row of every segment, including segments that verify.
+///
+/// Constraints are algebraic relations among TAP VALUES, so evaluate them the way the verifier does
+/// — `poly_ext(mix, u, args)` — but with `u` read from the trace at row `r` instead of at the DEEP
+/// point. There is no domain arithmetic to get wrong, and a non-zero result names the row.
+#[cfg(not(target_os = "zkvm"))]
+fn hazync_119_tap_scan<H: risc0_zkp::hal::Hal<Elem = Val, ExtElem = ExtVal>>(
+    steps: usize,
+    code: &H::Buffer<Val>,
+    data: &H::Buffer<Val>,
+    accum: &H::Buffer<Val>,
+    out: &H::Buffer<Val>,
+    mix: &H::Buffer<Val>,
+) {
+    use rayon::prelude::*;
+    use risc0_zkp::adapter::{PolyExt, TapsProvider};
+    use risc0_zkp::field::Elem as _;
+
+    let taps = CircuitImpl.get_taps();
+    let circuit = CircuitImpl;
+    // arbitrary: we ask "is this row non-zero", not reconstruct the protocol
+    let poly_mix = ExtVal::new(Val::new(2), Val::new(3), Val::new(5), Val::new(7));
+
+    code.view(|c| { data.view(|d| { accum.view(|a| { out.view(|o| { mix.view(|m| {
+        // ⛔ index by the CONSTANTS, not by the order the buffers happen to be written. The group
+        // ids come from a macro and are not [code, data, accum]; assuming that order indexed past
+        // the end of a buffer (len 2,097,152, index 3,600,291).
+        let mut groups: [&[Val]; 3] = [c, c, c];
+        groups[REGISTER_GROUP_CODE] = c;
+        groups[REGISTER_GROUP_DATA] = d;
+        groups[REGISTER_GROUP_ACCUM] = a;
+        for (gi, g) in groups.iter().enumerate() {
+            let want = taps.group_size(gi) * steps;
+            if g.len() != want {
+                eprintln!(
+                    "[#119-TAP] group {gi} buffer is {} elems, taps expect {} ({} cols x {steps}) -- \
+                     layout assumption is wrong, aborting scan",
+                    g.len(), want, taps.group_size(gi)
+                );
+                return;
+            }
+        }
+        // The tap vector the verifier builds, but read at a trace ROW instead of at the DEEP point.
+        // Order must match risc0-zkp verify/mod.rs:336 exactly -- regs() outer, 0..reg.size() inner.
+        let tap_vec = |row: usize| -> Vec<ExtVal> {
+            let mut u: Vec<ExtVal> = Vec::new();
+            for reg in taps.regs() {
+                let g = groups[reg.group()];
+                for i in 0..reg.size() {
+                    let back = reg.back(i);
+                    let r = (row + steps - (back % steps)) % steps;
+                    let v = g[reg.offset() * steps + r];
+                    u.push(ExtVal::new(v, Val::ZERO, Val::ZERO, Val::ZERO));
+                }
+            }
+            u
+        };
+
+        // ⛔ NEGATIVE CONTROL. `violating_rows=0` on a witness that is KNOWN BAD is only evidence
+        // if this evaluator can produce a non-zero result at all. Reporting 0 on segments that
+        // verify proves nothing -- a function that always returns zero passes that test too.
+        //
+        // Perturb one tap at a time and count how many perturbations move `tot` off zero. A live
+        // evaluator moves for most of them; a dead one moves for none.
+        if std::env::var("HAZYNC_119_TAP_CONTROL").is_ok() {
+            let probes = [0usize, 1, steps / 2, steps - 2, steps - 1];
+            let (mut checked, mut moved) = (0usize, 0usize);
+            for &row in probes.iter() {
+                let mut u = tap_vec(row);
+                let base = circuit.poly_ext(&poly_mix, &u, &[o, m]).tot;
+                let (mut cr, mut mr) = (0usize, 0usize);
+                for k in 0..u.len() {
+                    let save = u[k];
+                    u[k] = save + ExtVal::ONE;
+                    let t = circuit.poly_ext(&poly_mix, &u, &[o, m]).tot;
+                    u[k] = save;
+                    cr += 1;
+                    if t != ExtVal::ZERO {
+                        mr += 1;
+                    }
+                }
+                eprintln!(
+                    "[#119-CTL] row={row} taps={} base_tot={:?} perturbed={cr} nonzero={mr}",
+                    u.len(),
+                    base.elems()
+                );
+                checked += cr;
+                moved += mr;
+            }
+            eprintln!(
+                "[#119-CTL] TOTAL perturbed={checked} nonzero={moved} -- evaluator is {}",
+                if moved == 0 { "DEAD (result is meaningless)" } else { "LIVE" }
+            );
+        }
+
+        // poly_ext is an interpreted walk over PolyExtStepDef -- far slower per row than poly_fp.
+        // Serially this is hours per segment; fanned out over the machine it is seconds.
+        let mut bad: Vec<usize> = (0..steps)
+            .into_par_iter()
+            .filter_map(|row| {
+                let tot = circuit.poly_ext(&poly_mix, &tap_vec(row), &[o, m]).tot;
+                (tot != ExtVal::ZERO).then_some(row)
+            })
+            .collect();
+        bad.sort_unstable();
+        let total_bad = bad.len();
+        bad.truncate(16);
+        eprintln!("[#119-TAP] steps={steps} violating_rows={total_bad} first={bad:?}");
+    }); }); }); }); });
+}
