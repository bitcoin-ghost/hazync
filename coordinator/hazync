#!/usr/bin/env python3
"""
hazync — Proof Party contributor CLI.

  hazync id                 # create/show your signing identity (ed25519)
  hazync rotate <key.hex>   # move an older key's blocks onto this box's identity (both keys sign)
  hazync pick               # show the board frontier (does not claim anything)
  hazync prove <id>         # prove that range on your GPU  -> a receipt .bin
  hazync submit <id>        # sign the receipt with your key and submit it for verification
  hazync run [id]           # claim + prove + submit (id optional: takes the earliest free block)
  hazync selftest           # pre-flight: prover present, guest id matches, can verify a real proof
  hazync fold [n]           # fold n adjacent proven ranges into wider ones (default 1) — helps everyone
  hazync spine [n]          # advance the genesis-anchored spine n steps, each absorbing the widest chunk available (default: all)

The party proves the chain forward from genesis, so you take a range near the current
frontier. The coordinator serves a ready-made witness bundle for each block in its window,
so you prove a block directly — no need to run your own node or replay the chain. An
arbitrary far-future block (past the served window) is not something a fresh contributor
can prove yet.

Config (env):
  COORD_URL   coordinator base URL   (default https://bitcoinghost.org/hazync — the public party)
  HAZYNC_HOST path to the prover `host` binary. Optional: if unset, the binary is looked for beside
              this script, in ~/.hazync/bin, in the current directory, then on PATH (CUDA preferred).
  BUNDLE_DIR  where fetched archive bundles live (default $HAZYNC_HOME/bundles)
  WITNESS_DIR legacy per-block witnesses, replay fallback (default $HAZYNC_HOME/witnesses)
  HAZYNC_HOME identity + receipts (default ~/.hazync). Point it elsewhere and you are a DIFFERENT
              contributor — a separate key and handle, credited separately on the board. Use it to
              hold more than one identity on a box, or to try the party without touching your real key.
Identity + receipts live under $HAZYNC_HOME (default ~/.hazync/).
"""
import os, sys, json, base64, subprocess, urllib.request, urllib.error, pathlib, threading, time, shutil, random, re
import signal
import concurrent.futures

# Where this contributor's IDENTITY lives — the signing key and handle, i.e. who gets credit.
#
# Overridable, because everything else here already is: COORD_URL, HAZYNC_HOST, WITNESS_DIR,
# BUNDLE_DIR, HAZYNC_PROVE_TIMEOUT and friends. WITNESS_DIR and BUNDLE_DIR are *derived from this
# path*, so without HAZYNC_HOME the tens of gigabytes under the root were redirectable and the 64-byte
# key was not — the one thing you might actually want to move.
#
# Point it somewhere else and you are a DIFFERENT CONTRIBUTOR. That is the point: it lets one box hold
# more than one identity, and lets you try the party without touching your real key. Before this, the
# only way to get a clean identity was to override the OS $HOME wholesale, which also redirects
# ~/.cargo, ~/.risc0 and anything else the prover's children read — a blunt instrument that happens to
# work. (hazync#92, found when a "fresh contributor" test silently ran as an established one and its
# work was credited to the handle already on the machine.)
HOME    = pathlib.Path(os.environ.get("HAZYNC_HOME") or os.path.expanduser("~/.hazync"))
KEY     = HOME / "key.hex"
HANDLE  = HOME / "handle"
RCPTDIR = HOME / "receipts"

# Default to the PUBLIC party, not localhost. Almost nobody running this has a coordinator of their
# own — they downloaded a release and want to contribute — and localhost sends them to a connection
# error that reads like the project is broken. `run-workers.sh` already defaulted this way; the two
# disagreeing meant the answer depended on which entry point you happened to use.
DEFAULT_COORD = "https://bitcoinghost.org/hazync"
COORD   = os.environ.get("COORD_URL", DEFAULT_COORD).rstrip("/")


def _find_host():
    """Locate the prover binary without making the contributor state a path.

    Requiring HAZYNC_HOST means the first thing a new contributor meets is an error about an
    environment variable they have never heard of, immediately after a download that already put the
    binary on their disk. Explicit setting still wins; this is only the fallback.

    CUDA is preferred when both are present: someone who downloaded the CUDA build has a GPU and
    wants it used. If they do not, `selftest` catches it before any work is attempted.
    """
    env = os.environ.get("HAZYNC_HOST", "")
    if env:
        return env                                  # explicit always wins, even if wrong — selftest reports it

    names = ["hazync-host-x86_64-linux-gnu-cuda", "hazync-host-cuda",
             "hazync-host-x86_64-linux-gnu", "hazync-host", "host"]
    here = pathlib.Path(__file__).resolve().parent
    for d in (here, HOME / "bin", HOME, pathlib.Path.cwd()):
        for n in names:
            p = d / n
            if p.is_file() and os.access(p, os.X_OK):
                return str(p)
    # PATH is searched only for hazync-prefixed names. A bare `host` on PATH is BIND's DNS lookup
    # utility on essentially every Linux box — picking it up reports "prover binary present:
    # /usr/bin/host" and then fails on `method-id` with something that reads like a corrupt download.
    # In a hazync-owned directory the name is unambiguous; on PATH it is not.
    for n in names:
        if not n.startswith("hazync-"):
            continue
        p = shutil.which(n)
        if p:
            return p
    return ""


HOSTBIN = _find_host()
WITNESS = os.environ.get("WITNESS_DIR", str(HOME / "witnesses"))
BUNDLES = os.environ.get("BUNDLE_DIR", str(HOME / "bundles"))   # archive-node bundles fetched from the coordinator

def _ed():
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
        from cryptography.hazmat.primitives import serialization
    except ImportError:
        sys.exit("missing the signing library `cryptography`. Install it:\n"
                 "  sudo apt install python3-cryptography      # Debian/Ubuntu\n"
                 "  or:  pip install cryptography")
    return Ed25519PrivateKey, serialization

def identity():
    HOME.mkdir(parents=True, exist_ok=True); RCPTDIR.mkdir(exist_ok=True)
    Ed25519PrivateKey, ser = _ed()
    if KEY.exists():
        sk = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(KEY.read_text().strip()))
    else:
        sk = Ed25519PrivateKey.generate()
        KEY.write_text(sk.private_bytes(ser.Encoding.Raw, ser.PrivateFormat.Raw, ser.NoEncryption()).hex())
        KEY.chmod(0o600)
    pub = sk.public_key().public_bytes(ser.Encoding.Raw, ser.PublicFormat.Raw).hex()
    handle = HANDLE.read_text().strip() if HANDLE.exists() else ("ghost:" + pub[:6])
    return sk, pub, handle


_WARNED_DEFAULT_HANDLE = False


def warn_if_default_handle(brief=False):
    """Say so, ONCE, when work is about to be credited to a machine-generated name.

    `brief` exists because the module-level "once" is once PER PROCESS, and `hazync run` is a fresh
    process per block — so the full notice on the submit path would print every few seconds forever,
    which is how a warning becomes wallpaper. The loop gets one line; the pre-flight paths a human
    actually reads (`selftest`, and run-workers.sh at fleet start) get the whole thing.

    The fallback `ghost:<pubkey[:6]>` is a sensible default and a silent one, and silence is the
    problem: a fleet ran for weeks attributing 29,676 proofs to `ghost:86cae5` because nobody ran
    `hazync id`, and it was only noticed by looking at the public board. Nothing was broken — the
    handle is a display label, the pubkey is the identity, and re-attribution needed no re-proving —
    but the person doing the work had their name off it the whole time.

    Deliberately a warning and not a prompt or a refusal: proving must run unattended on a fleet, and
    a default handle is a valid choice for anyone who wants one. It just should not be an ACCIDENT.
    """
    global _WARNED_DEFAULT_HANDLE
    if _WARNED_DEFAULT_HANDLE or HANDLE.exists():
        return
    _WARNED_DEFAULT_HANDLE = True
    _, pub, handle = identity()
    if brief:
        print(f"  (crediting '{handle}' — no handle set; `hazync id <yourname>` to change it)")
        return
    print(f"\n  ! no handle set — this work will be credited to '{handle}', a name derived from your")
    print( "    public key. That is fine if you want it; set one now if you do not:")
    print( "        hazync id <yourname>")
    print( "    Only the LABEL changes: your key, and every proof you have already made, are untouched.\n")

def _open(req, timeout, tries=4):
    # Open a request with a timeout and retry on TRANSIENT network errors only — a real HTTP response
    # (4xx/5xx, incl. 409 already-claimed / 404 no-witness) is returned to the caller, never retried.
    # Without this a single flaky request hangs the whole CLI (the old no-timeout behaviour).
    for k in range(tries):
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError:
            raise                                        # server answered — let the caller handle it
        except (urllib.error.URLError, OSError) as e:    # connection refused / reset / timeout
            if k + 1 >= tries:
                raise SystemExit(f"coordinator {COORD} unreachable after {tries} tries: {e}")
            time.sleep(2 * (k + 1))                       # 2s, 4s, 6s backoff

def post(path, body):
    req = urllib.request.Request(COORD + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"})
    try:
        return json.load(_open(req, timeout=180))        # submit triggers verification — allow time
    except urllib.error.HTTPError as e:                  # coordinator returns JSON {"error": ...} with a 4xx/5xx
        try: return json.loads(e.read().decode())
        except Exception: raise SystemExit(f"coordinator error {e.code}: {e.reason}")

def get(path):
    return _open(urllib.request.Request(COORD + path), timeout=60).read()

def witness_in_window(blk):
    # True if the coordinator currently serves the witness for `blk` (i.e. the block is inside the rolling
    # window a fresh contributor can prove). A cheap pre-flight so `run` never claims a range it can't fetch.
    try:
        get(f"/api/witness/{blk}"); return True
    except urllib.error.HTTPError:
        return False

def fetch_witnesses(lo, hi):
    # the prover replays blocks 1..hi to rebuild the accumulator, so it needs every witness up to hi.
    # pull any we don't already have from the coordinator's rolling window.
    os.makedirs(WITNESS, exist_ok=True)
    for i in range(1, hi + 1):
        wf = os.path.join(WITNESS, f"block_{i}.json")
        if os.path.exists(wf):
            continue
        try:
            data = get(f"/api/witness/{i}")
        except Exception as e:
            sys.exit(f"could not fetch witness for block {i} from {COORD}: {e}")
        with open(wf, "wb") as fh:
            fh.write(data)

def fetch_bundles(lo, hi):
    # Fetch an archive-node bundle for every block in [lo..hi]. Returns True iff all are available (the
    # bridge path — prove with NO replay); False if any block is missing or only a legacy per-block witness
    # exists, in which case the caller falls back to the replay path. A bundle carries in_roots + witness.
    os.makedirs(BUNDLES, exist_ok=True)
    for h in range(lo, hi + 1):
        bf = os.path.join(BUNDLES, f"bundle_{h}.json")
        if os.path.exists(bf):
            continue
        try:
            data = get(f"/api/witness/{h}")
            j = json.loads(data)
        except Exception:
            return False
        if "in_roots" not in j or "witness" not in j:
            return False                       # legacy per-block witness, not a bridge bundle
        with open(bf, "wb") as fh:
            fh.write(data)
    return True

def parse_range(rng):
    # "N" -> (N, N); "lo-hi" -> (lo, hi). Exits with a clear message on anything else.
    try:
        p = [int(x) for x in rng.split("-")]
    except ValueError:
        p = []
    if len(p) == 1:
        return p[0], p[0]
    if len(p) == 2 and p[1] >= p[0]:
        return p[0], p[1]
    sys.exit(f"invalid range '{rng}' — use 'N' (one block) or 'lo-hi' (e.g. 1000-1999)")

def cmd_id(args):
    _, pub, handle = identity()
    if args:
        HANDLE.write_text(args[0]); handle = args[0]
    print("handle :", handle); print("pubkey :", pub); print("coord  :", COORD)
    # Only prompt when there is nothing to prompt for. Printing "set a handle" straight after the user
    # HAS set one reads as though it did not take.
    if not args:
        print("(set a handle:  hazync id <name>)")

def cmd_rotate(args):
    """Move a previous key's blocks onto THIS box's identity (#113).

    The old secret is read, used to sign exactly one message, and never sent anywhere — the
    coordinator only ever sees the two public keys and the two signatures."""
    if not args:
        sys.exit("usage: hazync rotate <old-key.hex>\n"
                 "\n"
                 "  Moves the blocks proved by an older key onto this box's current identity, so a\n"
                 "  rebuilt or replaced prover keeps its place on the board.\n"
                 "\n"
                 "  <old-key.hex> is the 32-byte hex secret from the old box's ~/.hazync/key.hex.\n"
                 "  It is used locally to sign one message and is never transmitted.\n"
                 "\n"
                 "  Both keys must sign, so this can neither take someone else's blocks nor push\n"
                 "  yours onto them.")
    Ed25519PrivateKey, ser = _ed()
    p = pathlib.Path(args[0]).expanduser()
    if not p.exists():
        sys.exit(f"no such key file: {p}")
    try:
        old_sk = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(p.read_text().strip()))
    except Exception:
        sys.exit(f"{p} does not contain a 32-byte hex ed25519 secret key")
    new_sk, new_pub, handle = identity()
    old_pub = old_sk.public_key().public_bytes(ser.Encoding.Raw, ser.PublicFormat.Raw).hex()
    if old_pub == new_pub:
        sys.exit("that key IS this box's identity — nothing to rotate")
    ts = int(time.time())
    # Must match the coordinator's rotate_message() byte for byte.
    msg = f"hazync-rotate-v1:{old_pub}:{new_pub}:{ts}".encode()
    print(f"  from : {old_pub}")
    print(f"  to   : {new_pub}  ('{handle}')")
    r = post("/api/rotate", {"old_pubkey": old_pub, "new_pubkey": new_pub, "ts": ts,
                             "sig_old": old_sk.sign(msg).hex(), "sig_new": new_sk.sign(msg).hex(),
                             "handle": handle})
    if r.get("error"):
        sys.exit(f"rotation refused: {r['error']}")
    print(f"\n✓ done — blocks proved by {old_pub[:10]}… now count towards '{handle}'.")
    print("  The old key still works if a forgotten box is still running; its work resolves here too.")

def cmd_pick(args):
    """Show what you would be given next. Does NOT claim it — use `hazync run` for that."""
    st = json.loads(get("/api/state?slim=1").decode())
    print(f"board frontier: {st.get('frontier', '?')}")
    print("claim the next block with:  hazync run")

_HARD_ERR = ("parse bundle", "invalid type", "deserialize", "missing field", "METHOD_ID", "image id",
             "read bundle", "No such file", "no such file")
# #261: this box cannot run CUDA at all. Permanent for the box, so neither a smaller segment nor the next
# block can help -- and retrying is actively harmful: every retry of `run` CLAIMS a new block and then
# abandons it for CLAIM_TTL. A RunPod 4090 with no usable device claimed and abandoned 14 blocks in 15
# minutes this way and froze the board frontier. Exit EX_CONFIG so run-workers.sh stops the loop.
_DEVICE_FATAL = ("cudaErrorNoDevice", "no CUDA-capable device", "CUDA driver version is insufficient",
                 "cudaErrorInsufficientDriver", "cudaErrorInitializationError", "CUDA_ERROR_NO_DEVICE",
                 "forward compatibility was attempted on non supported HW")

_SEG_MIN = 18                                       # below this the segments stop repartitioning usefully
_SEG_TOP_CACHE = {"v": False}                       # False = not yet asked (None is a valid answer)

def _seg_ladder(env):
    # [first attempt, then every smaller size down to _SEG_MIN]. The first attempt is None = "let the
    # binary (or the operator's HAZYNC_SEG_PO2) decide"; the rest walk down from whatever that was, with
    # no duplicate rung. Falls back to the old fixed ladder if the binary predates `seg-po2`.
    if env.get("HAZYNC_SEG_PO2", "").isdigit():
        top = int(env["HAZYNC_SEG_PO2"])
    else:
        if _SEG_TOP_CACHE["v"] is False:             # ask the binary once per run, not once per block
            _SEG_TOP_CACHE["v"] = None
            try:
                r = subprocess.run([HOSTBIN, "seg-po2"], capture_output=True, text=True, timeout=30)
                if r.returncode == 0 and r.stdout.strip().isdigit():
                    _SEG_TOP_CACHE["v"] = int(r.stdout.strip())
            except Exception:
                pass
        top = _SEG_TOP_CACHE["v"]
    if top is None:
        return (None, 20, 19, 18)
    return (None, *range(top - 1, _SEG_MIN - 1, -1))

# Lines that carry no information about WHY something failed. `note: run with RUST_BACKTRACE=1` is
# almost always the LAST line rustc-built binaries emit, so taking splitlines()[-1] — as this did —
# reliably captured the one line that says nothing.
#
# That was not merely unhelpful. The reason travels to the coordinator with the release and is what
# decides whether a failure is environmental (OOM, capacity) or block-implicating: an out-of-memory
# recorded as "note: run with RUST_BACKTRACE=1" is invisible to that classifier, so a capacity blip
# would be counted against the block and could park perfectly good work.
_NOISE = ("note:", "stack backtrace", "run with `rust_backtrace", "warning:")

def _err_tail(stderr, keep=4):
    """The most informative trailing lines of a failed prove, noise dropped."""
    lines = [l.strip() for l in (stderr or "").splitlines() if l.strip()]
    signal = [l for l in lines if not any(n in l.lower() for n in _NOISE)]
    picked = (signal or lines)[-keep:]
    return " | ".join(picked) if picked else "(no error output)"

import contextlib, fcntl

@contextlib.contextmanager
def gpu_lock(what="prove"):
    """Serialise GPU work across every worker on this box.

    Two risc0 jobs on one card do not fail politely. They fail when their allocation PEAKS happen to
    coincide, which is intermittent and looks like nothing else: on 2026-08-01 a prover on a 46 GB
    L40S could not allocate 268 MB while `nvidia-smi` showed 30 GB free a second later. Peak, not
    average, is what has to fit — and running a prover and a folder concurrently means adding two
    peaks that were each measured alone.

    Lowering HAZYNC_SEG_PO2 shrinks the peak but does not stop them colliding; it only makes the
    collision rarer, which is worse than fixing it because it turns a hard failure into an occasional
    one. So: one GPU job at a time, per box. Both jobs still run, interleaved, and the card is busy
    either way — proving is not idle while a fold holds the lock, it is queued.

    Set HAZYNC_GPU_LOCK=none to disable (a box with genuinely independent GPUs per worker), or point
    it at a per-device path when pinning workers with CUDA_VISIBLE_DEVICES.
    """
    path = os.environ.get("HAZYNC_GPU_LOCK", "/tmp/hazync-gpu.lock")
    if path == "none":
        yield
        return
    # ACQUIRE and BODY are separate try blocks, and that separation is the whole point.
    #
    # They used to share one, with `except OSError: yield` meaning "cannot lock — work anyway". But a
    # contextmanager receives the body's exceptions THROWN IN at its yield, so any OSError raised
    # inside `with gpu_lock(...)` landed in that handler too and yielded a SECOND time. A generator
    # that yields twice makes contextlib raise `RuntimeError: generator didn't stop after throw()`
    # OVER THE TOP of the original error — so the real failure was never reported.
    #
    # It bit folding hardest, because a fold is the long GPU job most likely to fail: every fold error
    # since has been reported as a lock error, and nothing has been folded from genesis while the
    # cause stayed invisible. Failing to acquire a lock and failing to do the work are different
    # things and no longer share a handler.
    fh = None
    try:
        fh = open(path, "a+")
        t0 = time.time()
        fcntl.flock(fh, fcntl.LOCK_EX)
        waited = time.time() - t0
        if waited > 5:
            print(f"  (waited {waited:.0f}s for the GPU — another worker was {what}ing)", flush=True)
    except OSError:                # cannot lock (odd filesystem) — proceed rather than refuse to work
        if fh is not None:
            try: fh.close()
            except Exception: pass
        fh = None
    try:
        yield
    finally:
        if fh is not None:
            try:
                fcntl.flock(fh, fcntl.LOCK_UN); fh.close()
            except Exception:
                pass

# #256: a prove is watched for PROGRESS, not silence. The host prints one line per completed segment
# (HAZYNC_PROGRESS_EVERY=1, set below); a stall is "no segment finished for a long time", never "quiet".
_PROGRESS_RE = re.compile(r"(segment \d+/\d+|executed, \d+ segments)")


def _prove_watched(argv, env, work, label, _beat_range=None, _beat_pk=None, _beat_sk=None):
    """Run one prove attempt, streaming its output. Returns (returncode, stderr_text, stalled, why).

    `stalled` is True when the watchdog killed it: no progress line inside the allowed window.
    """
    # A prove used to be SILENT until it returned (stderr captured, nothing in the log while the GPU
    # worked). That made a slow block and a hung one indistinguishable, and on 2026-08-01 it cost real
    # work -- three healthy provers on block 39,318 (381 inputs, ~31 min of legitimate GPU) were
    # mistaken for hangs and killed. So the watchdog below keys on COMPLETED SEGMENTS, which a healthy
    # prove produces every few seconds on a GPU and a hung one never does.
    # Only the prove commands report progress (#256). fold-range prints nothing until it returns, so it
    # keeps the old outer bound alone -- a progress window on it would kill every healthy fold.
    watch = bool(argv) and argv[0] in ("prove-range", "prove-range-bridge")
    stall_min = float(os.environ.get("HAZYNC_STALL_MIN", "600"))           # 10 min without a segment
    first_max = float(os.environ.get("HAZYNC_FIRST_PROGRESS", "1800"))    # execute + cold CUDA start
    outer = float(os.environ.get("HAZYNC_PROVE_TIMEOUT", "21600" if watch else "5400"))   # finite, not tight
    tick_s = float(os.environ.get("HAZYNC_TICK", "60"))
    # Own process group, so a kill takes the WHOLE prover down -- any child it spawned (an external r0vm,
    # say) would otherwise survive holding GPU memory and the output pipes.
    proc = subprocess.Popen([HOSTBIN, *argv], env=env, cwd=work, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, bufsize=1, start_new_session=True)
    t0 = time.time()
    st = {"last": None, "n": 0, "gaps": [], "line": ""}      # last progress time, count, inter-segment gaps
    err_chunks = []

    def _read_out():
        for line in proc.stdout:
            sys.stdout.write(line); sys.stdout.flush()           # keep the host's output in the worker log
            if _PROGRESS_RE.search(line):
                now = time.time()
                if st["last"] is not None:
                    st["gaps"].append(now - st["last"])
                st["last"], st["n"], st["line"] = now, st["n"] + 1, line.strip()

    def _read_err():
        for line in proc.stderr:
            err_chunks.append(line)

    readers = [threading.Thread(target=_read_out, daemon=True), threading.Thread(target=_read_err, daemon=True)]
    for t in readers:
        t.start()
    done = threading.Event()

    def _tick():
        beaten_at = 0
        while not done.wait(tick_s):
            mins = int(time.time() - t0) // 60
            where = f" -- last: {st['line']}" if st["line"] else " -- no segment finished yet"
            print(f"  … {label}: still proving, {mins}m elapsed{where}", flush=True)
            # Beat the claim while we work -- but ONLY if a segment finished since the last beat. Without
            # beats a prove longer than CLAIM_TTL has its block handed to someone else mid-flight (block
            # 741,000: 55 min against a 60 min expiry). With beats on a timer alone, a HUNG prover kept its
            # claim alive for hours (#256). Progress-gated: a stuck worker's claim lapses as designed.
            # Signed (audit #5, L-2), INTEGER seconds (the coordinator rebuilds this exact string).
            if _beat_range and st["n"] > beaten_at:
                beaten_at = st["n"]
                try:
                    _bts = int(time.time())
                    _bsig = _beat_sk.sign(f"{_beat_range}:{_bts}".encode()).hex()
                    post("/api/beat", {"range": _beat_range, "pubkey": _beat_pk, "ts": _bts, "sig": _bsig})
                except Exception:
                    pass

    threading.Thread(target=_tick, daemon=True).start()
    stalled, why = False, ""
    try:
        while proc.poll() is None:
            now = time.time()
            if now - t0 > outer:
                stalled, why = True, f"no result after {outer:.0f}s (HAZYNC_PROVE_TIMEOUT)"
            elif watch and st["last"] is None and now - t0 > first_max:
                stalled, why = True, f"no segment finished within {first_max:.0f}s of starting (HAZYNC_FIRST_PROGRESS)"
            elif watch and st["last"] is not None:
                g = sorted(st["gaps"])
                window = max(stall_min, 20 * g[len(g) // 2]) if g else max(stall_min, first_max)
                if now - st["last"] > window:
                    stalled, why = True, (f"no progress for {now - st['last']:.0f}s (window {window:.0f}s) "
                                          f"-- last: {st['line']}")
            if stalled:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)      # the whole group; releases the GPU memory
                except ProcessLookupError:
                    pass
                break
            time.sleep(0.5)
        proc.wait()
    finally:
        done.set()
        for t in readers:
            t.join(timeout=5)
    return proc.returncode, "".join(err_chunks), stalled, why


def _run_with_seg_retry(argv, env, work, label, _beat_range=None, _beat_pk=None, _beat_sk=None):
    # risc0 4.0.5 panics on ~10% of workloads (a preflight segment-boundary bug) — on CPU AND cuda, and on
    # EVERY prove path (single-block prove-range/-bridge AND fold-range). Retry with progressively smaller
    # proving segments; smaller segments repartition the work and clear the boundary, and the receipt is
    # identical (guest unchanged, METHOD_ID unchanged), so it's transparent.
    #
    # The ladder STARTS at the binary's own default rather than a hardcoded number: `host seg-po2` reports
    # 21 for a cuda build and 20 for CPU (a po2-21 segment needs ~2x the working memory — a win on a GPU,
    # a pure cost on a RAM-limited CPU box). Hardcoding the top rung would override that per-backend choice
    # and, on CPU, waste a full duplicate prove attempt at a size that just failed. An operator's explicit
    # HAZYNC_SEG_PO2 wins the first attempt for the same reason.
    #
    # #256: the ladder is for FAILURES. A stall (no progress) or the outer timeout is not a segment-size
    # problem -- smaller segments mean MORE of them, so a slow prove only gets slower -- and walking the
    # ladder on it cost up to 4 x 90 min per stuck block. A stall is retried ONCE at the same size, then
    # the worker gives up loudly, naming how far it got.
    last = ""
    ladder = list(_seg_ladder(env))
    i, stall_retried = 0, False
    while i < len(ladder):
        _po2 = ladder[i]
        _env = dict(env) if _po2 is None else dict(env, HAZYNC_SEG_PO2=str(_po2))
        _env.setdefault("HAZYNC_PROGRESS_EVERY", "1")
        with gpu_lock("prov"):
            rc, err, stalled, why = _prove_watched(argv, _env, work, label, _beat_range, _beat_pk, _beat_sk)
        if stalled:
            if not stall_retried:
                stall_retried = True
                print(f"  {label}: {why} -- killed; retrying ONCE at the same segment size", flush=True)
                continue
            sys.exit(f"{label}: {why} -- gave up after one retry. A stall is not a segment-size problem, so "
                     f"the segment ladder was not walked (#256).")
        if err:                                         # keep the host's real error output in the worker log
            sys.stderr.write(err); sys.stderr.flush()
        if rc == 0:
            return
        last = err.strip()
        if any(h in last for h in _DEVICE_FATAL):
            print(f"\nFATAL: {label}: this box has no usable CUDA device -- {_err_tail(last)}\n"
                  f"  Every prove here fails, and each retry would claim (and abandon) another block.\n"
                  f"  Stopping this worker. Fix the GPU/driver, or run a CPU build of the host.",
                  file=sys.stderr, flush=True)
            sys.exit(EX_CONFIG)
        if any(h in last for h in _HARD_ERR):           # smaller segments won't help — fail fast, loudly
            tail = _err_tail(last)
            sys.exit(f"{label}: {tail}\n(not a segment-size issue — retrying smaller won't help; check the "
                     f"bundle/witness and that `host method-id` matches reproduce/METHOD_ID)")
        i += 1
    sys.exit(f"{label} failed to prove even at reduced segment size (SEG_PO2=18) — last error: {_err_tail(last)}")


def cmd_prove(args, claimed=False):
    """Prove `rng`. `claimed` is True only when `rng` came from POST /api/claim (the no-argument
    `hazync run`): only then is there a claim for the heartbeat to keep alive (#251)."""
    rng = args[0]
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("set HAZYNC_HOST to the prover `host` binary (needs a GPU box + witnesses in WITNESS_DIR)")
    _, pub, _ = identity()
    lo, hi = parse_range(rng)                            # "n" (single block) or "lo-hi" (range)
    RCPTDIR.mkdir(parents=True, exist_ok=True)
    out = RCPTDIR / f"{rng}.bin"
    # Prove + fold in a dedicated per-range work dir (under ~/.hazync) so the host's range_*.hzk /
    # fold_*.bin intermediates never litter the CWD, never collide with a concurrent prove, and the final
    # os.replace stays on one filesystem (no EXDEV).
    work = RCPTDIR / f".work-{rng}"
    shutil.rmtree(work, ignore_errors=True); work.mkdir(parents=True, exist_ok=True)
    # Block 0 is the genesis anchor and is unprovable, so we start at max(lo, 1). The genesis-seed slot
    # 0-999 is thus proved as blocks 1..999; the coordinator (which pins the genesis in-boundary) accepts
    # a [1..hi] receipt for a [0..hi] claim. Starting at 1 also means a bad manual `run 0-...` no longer
    # crashes on `prove-range 0`.
    start = max(lo, 1)
    # Prefer the archive-node bridge: if the coordinator serves a ready-made bundle for every block in the
    # range, prove each with NO replay (O(1)/block). Otherwise fall back to the replay path, which rebuilds
    # the accumulator from genesis and so needs every witness up to hi.
    if fetch_bundles(start, hi):
        env = dict(os.environ, HAZYNC_BRIDGE_OUT=BUNDLES)
        prove_cmd = "prove-range-bridge"
        print(f"using archive-node bundles (no replay) for blocks {start}..{hi}")
    else:
        fetch_witnesses(start, hi)                    # pull any witnesses we're missing from the coordinator
        env = dict(os.environ, HAZYNC_WITNESS_DIR=WITNESS)
        prove_cmd = "prove-range"
        print(f"archive bundles unavailable — replaying from genesis for blocks {start}..{hi}")
    # The claim IS beaten while a prove runs — see the ticker in _run_with_seg_retry. The comment
    # that used to sit here said there was no lease to renew, which was true under free-running and
    # stopped being true when v0.12.1 brought claims back: a prove longer than CLAIM_TTL loses its
    # block mid-flight and the work is done twice.
    try:
        _sk, _pk, _ = identity()
        total = hi - start + 1
        print(f"proving range {rng} ({total} block{'s' if total != 1 else ''}) — the expensive step…")
        parts = []
        for i, h in enumerate(range(start, hi + 1), 1):
            _run_with_seg_retry([prove_cmd, str(h)], env, work, f"block {h}",
                                # #251: heartbeat ONLY a range we claimed. An explicit `run <range>` or
                                # `prove <range>` holds no claim, so every beat was a doomed 409 -- 400+
                                # of them from the first outside contributor, which made a healthy long
                                # run look like a stuck worker hammering the coordinator.
                                _beat_range=rng if claimed else None, _beat_pk=_pk, _beat_sk=_sk)
            parts.append(_prover_out(work, f"range_{h}").name)
            if total > 1 and (i % 50 == 0 or i == total):
                print(f"  …proved {i}/{total} blocks — the board frontier advances once the whole range is proved + submitted", flush=True)
        _fold_and_save(parts, out, work, env)
        print("receipt:", out)
    finally:
        pass
        shutil.rmtree(work, ignore_errors=True)          # drop the range_*/fold_* intermediates

def _fold_conc():
    # Folds WITHIN a tree level are mutually independent (nothing at level N depends on anything else at
    # level N), so they can run concurrently. Default 1 — i.e. unchanged behaviour — because the bound is
    # GPU VRAM and overcommitting does not degrade gracefully: it OOMs mid-fold in `hash_rows`.
    #
    # Measured on a 46 GB L40S with the board paused (#27):
    #   K=1  3.00 s/fold   peak  8,949 MiB
    #   K=2  2.00 s/fold   peak 11,742 MiB   <- 1.5x, safe
    #   K=4  OOM ("Failure during hash_rows ... out of memory"), peak 40,649 MiB
    # A single fold already drives the GPU to 100% utilisation, so the win is scheduling-gap sized, not
    # linear in K. Raise this deliberately, per box — there is no safe auto-detect across card sizes.
    try:
        v = int(os.environ.get("HAZYNC_FOLD_CONCURRENCY", "1"))
    except ValueError:
        v = 1
    return max(1, v)

def _fold_level(parts, rnd, work, env, conc):
    # One level of the fold tree. Returns the next level's parts, preserving order (order matters: fold
    # seams must stay adjacent, so parts[i] and parts[i+1] must remain neighbours in the result).
    jobs, nxt = [], []
    for i in range(0, len(parts), 2):
        if i + 1 < len(parts):
            m = f"fold_r{rnd}_{i}.bin"
            jobs.append((m, parts[i], parts[i + 1]))
            nxt.append(m)
        else:
            nxt.append(parts[i])                      # odd one out is carried up untouched
    if not jobs:
        return nxt

    def _one(job):
        m, a, b = job
        try:
            _run_with_seg_retry(["fold-range", a, b, m], env, work, f"fold {a}+{b}")
        except SystemExit as e:
            # _run_with_seg_retry exits the process on failure. Inside a worker thread that would only
            # kill the thread and let the level "succeed" with a missing receipt, so it must become a
            # value we can act on.
            return str(e.code)
        return None

    if conc <= 1:
        for j in jobs:                                 # serial path unchanged — no pool, no threads
            err = _one(j)
            if err:
                sys.exit(err)
        return nxt

    errs = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=conc) as ex:
        for err in ex.map(_one, jobs):
            if err:
                errs.append(err)
    if errs:
        # Fail the whole level rather than proceeding with a hole in it: a partial level would fold
        # non-adjacent ranges together at the next level and produce a receipt with a bogus seam.
        sys.exit(f"{len(errs)} of {len(jobs)} folds failed at level {rnd}; first error:\n{errs[0]}")
    return nxt

def _prover_out(work, stem):
    """Resolve the prover's DEFAULT output for `stem` — `.hzk` since #278, `.bin` before it.

    The per-block proves deliberately do not pass HAZYNC_OUT, so this filename is a CONTRACT with
    the host binary rather than a local choice. Resolving it instead of assuming it means a worker
    and a host from different releases still fold. The pair is normally rolled together, but
    "normally" is not a guarantee, and guessing wrong fails AFTER the expensive step is paid for:
    the prove succeeds, the fold cannot find its input, and the block is lost.

    scripts/check-proof-names.sh keeps this in step with the host's own defaults.
    """
    hzk = pathlib.Path(work) / f"{stem}.hzk"
    return hzk if hzk.exists() else pathlib.Path(work) / f"{stem}.bin"


def _fold_and_save(parts, out, work, env):
    # Guard first: if a prove failed, its receipt is absent and the rename below raises a
    # FileNotFoundError that hides the actual failure. Say what is missing instead.
    missing = [p for p in parts if not os.path.exists(os.path.join(work, p))]
    if missing:
        sys.exit(f"prove produced no receipt for {', '.join(missing)} — see the error above; nothing was submitted.")
    # Recursively fold the per-block receipts into one; all I/O is inside `work` (cwd=work). fold-range hits
    # the same risc0 segment-boundary bug as the block prove, so it goes through the same seg-retry path.
    conc = _fold_conc()
    rnd = 0
    while len(parts) > 1:
        rnd += 1
        before, t0 = len(parts), time.time()
        parts = _fold_level(parts, rnd, work, env, conc)
        print(f"  …folding into one receipt: {before} → {len(parts)}"
              f"  ({time.time() - t0:.0f}s, concurrency {conc})", flush=True)
    os.replace(os.path.join(work, parts[0]), out)

def cmd_submit(args):
    # Warn HERE, not only at startup: this is the moment work gets attributed, and it is the path a
    # long-running worker loop takes every time. `hazync run` calls straight through to it, so keep it
    # to one line — see warn_if_default_handle's note on why.
    warn_if_default_handle(brief=True)
    rng = args[0]; sk, pub, handle = identity()
    # Validate BEFORE the id reaches a path (audit #5, N-3). `hazync run` happens to call cmd_prove
    # first, which validates — but `hazync submit <rid>` is a documented standalone command, so that is
    # a property of one call order rather than of this function. Self-harm only, since RCPTDIR is the
    # caller's own directory, but building a path from an unvalidated argument is the habit worth not
    # having: the coordinator applies exactly this discipline to the same value.
    parse_range(rng)
    f = RCPTDIR / f"{rng}.bin"
    if not f.exists(): sys.exit(f"no receipt at {f} — run `hazync prove {rng}` first")
    receipt = f.read_bytes()
    sig = sk.sign(receipt).hex()
    res = post("/api/submit", {"range": rng, "pubkey": pub, "handle": handle,
                               "sig": sig, "receipt": base64.b64encode(receipt).decode()})
    if res.get("ok"):
        print(f"✓ range {rng}: the coordinator re-verified your proof and put it on the board as '{handle}'.")
        sys.exit(0)
    if "already proven" in str(res.get("error", "")):
        # Benign race: another prover landed this block first. Not a failure — don't alarm the contributor
        # (and cmd_run, seeing exit 0, won't release: the block is already verified).
        print(f"✓ range {rng} was already proved by someone else — nothing to do.")
        sys.exit(0)
    err = str(res.get("error") or res)
    print("✗ submit rejected:", err)
    # A guest-id mismatch is not a bad block, it is a worker that can never land anything (#99). Left
    # as a plain exit 1 the loop sleeps 3s and claims the next block forever: three GPUs once ran flat
    # out for a day at 66% utilisation, producing nothing, because a re-baseline landed AFTER they
    # started and nothing re-asked the question.
    #
    # The issue suggested counting ten rejections before giving up. Re-asking /api/meta settles it on
    # the FIRST one and more sharply: if the coordinator's id still differs from ours, this is not a
    # race with a re-baseline, it is a worker built against a different guest, and the tenth rejection
    # would tell us nothing the first did not. If the ids now AGREE we were mid-re-baseline, which is
    # benign and genuinely worth retrying.
    if "METHOD_ID" in err or "guest image id" in err:
        sys.exit(_guest_mismatch_exit(err))
    sys.exit(1)


# Exit status for "this worker is misconfigured and retrying cannot help" (EX_CONFIG). Distinct from 1
# so a supervising loop can stop instead of spinning; run-workers.sh breaks on it.
EX_CONFIG = 78


def _guest_mismatch_exit(err):
    """Re-check our guest id against the coordinator's. Returns the exit status to use."""
    # Hex case is not part of the identity, so neither side may depend on it (audit #6, F-6). A
    # lowercase-only regex silently fails to parse an uppercase id, which loops without diagnosing;
    # a case-sensitive comparison reads an uppercase coordinator id as a permanent mismatch and stops
    # the whole fleet on EX_CONFIG. Both failures would be false and both would be confusing.
    mine = theirs = None
    try:
        out = subprocess.run([HOSTBIN, "method-id"], capture_output=True, text=True, timeout=60).stdout
        m = re.search(r"[0-9a-fA-F]{64}", out or "")
        mine = m.group(0).lower() if m else None
    except Exception:
        pass
    try:
        t = json.loads(get("/api/meta")).get("method_id")
        theirs = t.lower() if isinstance(t, str) else None
    except Exception:
        pass

    if not mine or not theirs:
        # Could not establish it either way — do NOT escalate to fatal on a failed lookup, or an
        # unreachable coordinator would stop a fleet that is otherwise fine.
        print(f"  could not compare guest ids (mine={mine or '?'}, coordinator={theirs or '?'}) — "
              f"retrying rather than assuming the worst.")
        return 1
    if mine == theirs:
        print(f"  our guest id matches the coordinator ({mine[:8]}…) — that rejection was a race with a "
              f"re-baseline, not a misconfiguration. Retrying.")
        return 1
    print(f"\nFATAL: guest id mismatch — every proof this worker makes will be REJECTED.\n"
          f"  this worker    : {mine}\n"
          f"  coordinator    : {theirs}\n"
          f"  Rebuild the guest, or point HAZYNC_HOST at a binary built from the coordinator's guest.\n"
          f"  Nothing this worker proves can land until those two ids are equal.", file=sys.stderr)
    return EX_CONFIG

def cmd_selftest(args):
    # One command a contributor runs BEFORE committing a GPU to real work: confirm the prover is present,
    # its guest id matches this coordinator (else every submit is rejected), and it can actually verify a
    # real board proof end to end. Catches the common "built a different guest" trap up front.
    print("hazync selftest — checking your setup before you prove real work\n")
    # selftest is the documented "run this before committing a GPU" step, so it is exactly where an
    # unset handle should surface — before the hours, not after them.
    warn_if_default_handle()
    ok = True
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("✗ no prover binary found.\n"
                 "  Looked beside this script, in ~/.hazync/bin, in the current directory, and on PATH.\n"
                 "  Download one from https://github.com/bitcoin-ghost/hazync/releases/latest\n"
                 "  (hazync-host-x86_64-linux-gnu-cuda for an NVIDIA GPU, or ...-linux-gnu for CPU),\n"
                 "  put it next to this script and `chmod +x` it — or set HAZYNC_HOST=/path/to/host.")
    print(f"✓ prover binary present: {HOSTBIN}")
    try:
        r = subprocess.run([HOSTBIN, "method-id"], capture_output=True, text=True, timeout=30)
        mine = next((t for t in r.stdout.split() if len(t) == 64 and all(c in "0123456789abcdef" for c in t)), None)
    except Exception as e:
        sys.exit(f"✗ could not run `{HOSTBIN} method-id`: {e}")
    if not mine:
        sys.exit("✗ `host method-id` printed no image id — is this the hazync host binary?")
    print(f"✓ your guest METHOD_ID: {mine}")
    try:
        want = json.loads(get("/api/meta")).get("method_id")
    except Exception as e:
        print(f"! could not reach {COORD}/api/meta to compare ids ({e}) — skipping the match check"); want = None
    if want and want == mine:
        print("✓ matches the coordinator — your proofs will be accepted")
    elif want:
        print(f"✗ METHOD_ID MISMATCH — the coordinator expects {want}.\n"
              "  You built a different guest, so every proof would be rejected. Use the prebuilt release\n"
              "  binary, or the reproducible build (reproduce/Dockerfile). (Nothing was submitted.)")
        ok = False
    try:
        proof = get("/api/proof/1")
        RCPTDIR.mkdir(parents=True, exist_ok=True)
        pf = RCPTDIR / "selftest_proof.bin"; pf.write_bytes(proof)
        vr = subprocess.run([HOSTBIN, "verify-any", str(pf)], capture_output=True, text=True, timeout=120)
        try: pf.unlink()
        except OSError: pass
        if vr.returncode == 0 and any(l.startswith("RANGE-OK") for l in vr.stdout.splitlines()):
            print("✓ verified a real board proof end to end (verify-any → RANGE-OK)")
        else:
            print(f"✗ verify-any failed: {(vr.stdout + vr.stderr).strip()[-200:]}"); ok = False
    except Exception as e:
        print(f"! could not fetch/verify a sample proof ({e}) — skipping the verify check")
    # ACTUALLY PROVE SOMETHING.
    #
    # Everything above passes without the prover ever running: method-id reads a constant, verify-any
    # checks a receipt. So selftest reported "ALL GOOD" to a contributor whose very first `hazync run`
    # then died on a missing r0vm — a clean bill of health precisely where it mattered. A pre-flight
    # that cannot fail the way the real thing fails is not a pre-flight.
    #
    # Block 1 is the cheapest real prove there is: one coinbase, no spends.
    try:
        wit = get("/api/witness/1")
        wd = pathlib.Path(WITNESS); wd.mkdir(parents=True, exist_ok=True)
        (wd / "bundle_1.json").write_bytes(wit)
        work = RCPTDIR / ".selftest"; work.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ, HAZYNC_BRIDGE_OUT=str(wd))
        print("… proving block 1 as a real pre-flight (this is the step that actually exercises the prover)")
        r = subprocess.run([HOSTBIN, "prove-range-bridge", "1"], cwd=str(work), env=env,
                           capture_output=True, text=True, timeout=1800)
        proved = _prover_out(work, "range_1")
        if r.returncode == 0 and proved.exists():
            print("✓ proved a real block end to end — your prover works")
            try: proved.unlink()
            except OSError: pass
        else:
            tail = _err_tail(r.stderr or r.stdout)
            print("✗ PROVING FAILED — this is what `hazync run` would have hit:")
            for line in tail.splitlines()[:4]:
                print("   ", line)
            if "No such file or directory" in (r.stderr or ""):
                print("    Looks like a missing `r0vm`. This binary proves in-process by default;")
                print("    if you set RISC0_PROVER=ipc you must install r0vm separately.")
            ok = False
    except Exception as e:
        print(f"! could not run the prove check ({e}) — treating as a FAILURE, not a skip")
        ok = False

    # Which JOBS this coordinator supports. Proving works against every coordinator; `fold` and
    # `spine` need endpoints that only exist from v0.13.0, and a coordinator that predates them
    # answers 404. That is not a fault in the contributor's setup, but it reads like one at the
    # moment of failure — v0.13.0 shipped a worker that reported a missing /api/spine as
    # "✗ spine submission rejected", sending people to look for a problem with their own proof.
    #
    # Reporting it HERE, in the pre-flight, is the difference between knowing up front which jobs are
    # available and finding out after fetching a receipt. Never fails the selftest: proving is the
    # job that matters and it does not depend on either endpoint.
    jobs = []
    for name, path in (("fold", "/api/foldable"), ("spine", "/api/spine")):
        try:
            get(path)
            jobs.append(name)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                # /api/spine 404s BOTH when the endpoint is absent and when no spine exists yet, and
                # the two are indistinguishable from here. Say what is actually known.
                print(f"· `hazync {name}` unavailable on this coordinator ({path} → 404)"
                      + (" — either it predates the spine, or none has been started yet"
                         if name == "spine" else " — it predates fold distribution"))
            else:
                print(f"· `hazync {name}` check inconclusive ({path} → HTTP {e.code})")
        except Exception:
            print(f"· `hazync {name}` check inconclusive (coordinator unreachable)")
    if jobs:
        print("✓ this coordinator also accepts: " + ", ".join(f"`hazync {j}`" for j in jobs)
              + " — cheaper than proving, and they are what make the board checkable in one download")

    print()
    if ok:
        print("ALL GOOD — you're ready. Start proving with `hazync run`.")
    else:
        sys.exit("SETUP INCOMPLETE — fix the ✗ items above before `hazync run`.")

def cmd_run(args):
    # FREE-RUNNING (#37). There is no claim, no lease, no heartbeat and nothing to hand back: proving
    # is unallocated, so a worker that dies mid-block leaves no state behind. That removes the entire
    # class of orphaned-claim failures this function used to exist to manage.
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("no prover binary found — run `hazync selftest` for where it looked.")
    if args:
        rng = args[0]
        lo, hi = parse_range(rng)
        # Still worth checking up front: proving a block whose witness cannot be fetched wastes the
        # whole prove, and the coordinator serves witnesses by direct file lookup so this is cheap.
        for probe in sorted({max(lo, 1), hi}):
            if not witness_in_window(probe):
                sys.exit(f"block {probe} has no witness on the coordinator yet — nothing was started.")
    else:
        # Claim the earliest block nobody has taken or finished. One block, one hour, no heartbeat.
        #
        # This replaced three stacked heuristics — random sampling to avoid collisions, a u^2 front
        # bias to stop holes opening, and fleet-rate-measured speed weighting so slow provers were not
        # perpetually outrun. All three existed to recover, approximately, what an ordered claim gives
        # exactly. The objections that removed claims (#37) were objections to WIDE claims: at width 1
        # a failure costs seconds, not a 67-minute range.
        _, pub, handle = identity()
        # #268: POST /api/claim is retried when its response is lost -- inside _open on a timeout or a
        # dropped connection, and here on an unreadable reply (a proxy 5xx page). The server had usually
        # committed the first claim, so every retry used to orphan a block for an hour. One nonce per
        # claim, reused by all of its retries, makes the server hand back the block it already gave.
        body = {"pubkey": pub, "handle": handle, "nonce": os.urandom(16).hex()}
        for k in range(3):
            try:
                res = post("/api/claim", body)
                break
            except SystemExit:
                if k == 2:
                    raise
                time.sleep(5 * (k + 1))
        if not res.get("ok"):
            sys.exit(f"nothing to claim: {res.get('error') or res}")
        rng = res["range"]
        print(f"claimed block {rng} (yours for {int(res.get('ttl', 3600) / 60)} min; "
              f"if you stop, it reopens by itself)")
    cmd_prove([rng], claimed=not args); cmd_submit([rng])

def cmd_fold(args):
    """Fold adjacent proven ranges into wider ones — a task in its own right, not a side effect (#37).

    Folding used to happen only inside `hazync run`, over the blocks of one claim. That made it
    hostage to claim width: at width 1 there is a single receipt, `_fold_and_save` has nothing to
    combine, and the whole fast fold path (#27) sits idle while the board accumulates unfolded
    per-block receipts. Decoupling them means claims stay width-1 and simple — which is what fixed the
    reliability trouble — while folding still happens.

    Unallocated, like proving. The coordinator suggests adjacent pairs whose fold does not exist yet;
    a duplicate fold is wasteful, not incorrect, and folding is far cheaper than proving.
    """
    if not HOSTBIN:
        sys.exit("no prover binary found — folding is a prove operation.\n"
                 "  Download one from https://github.com/bitcoin-ghost/hazync/releases/latest\n"
                 "  or set HAZYNC_HOST=/path/to/host.")
    want = int(args[0]) if args and args[0].isdigit() else 1
    sk, pub, handle = identity()
    work = RCPTDIR / ".fold-work"
    shutil.rmtree(work, ignore_errors=True); work.mkdir(parents=True, exist_ok=True)
    done = 0
    try:
        while done < want:
            try:
                pairs = json.loads(get("/api/foldable")).get("pairs", [])
            except urllib.error.HTTPError as e:
                # 404 means the coordinator predates this feature, not that anything went wrong here.
                # Saying "could not ask ... HTTP Error 404" sends the reader looking at their own setup.
                if e.code == 404:
                    sys.exit("this coordinator does not support folding yet (GET /api/foldable -> 404).\n"
                             "  The endpoint ships in v0.13.0 but has to be deployed on the coordinator side.\n"
                             "  Nothing is wrong with your setup.")
                sys.exit(f"could not ask the coordinator for foldable pairs: {e}")
            except Exception as e:
                sys.exit(f"could not ask the coordinator for foldable pairs: {e}")
            if not pairs:
                print("nothing to fold — every adjacent pair on the board is already folded.")
                break
            # Choose among the candidates rather than always taking the first, so concurrent workers
            # spread out without anything being allocated to them.
            p = random.choice(pairs)
            lp, rp, res = p["left"], p["right"], p["result"]
            lf, rf = work / f"l_{lp}.bin", work / f"r_{rp}.bin"
            try:
                lf.write_bytes(get(f"/api/proof/{lp}")); rf.write_bytes(get(f"/api/proof/{rp}"))
            except Exception as e:
                print(f"  could not fetch receipts for {lp} + {rp} ({e}) — skipping.")
                break
            out = work / f"fold_{res}.bin"
            print(f"folding {lp} + {rp} -> {res} …")
            with gpu_lock("fold"):
                r = subprocess.run([HOSTBIN, "fold-range", str(lf), str(rf), str(out)],
                                   capture_output=True, text=True)
            if r.returncode != 0 or not out.exists():
                both = (r.stdout or "") + (r.stderr or "")
                sys.exit(f"fold-range failed for {lp} + {rp}:\n{both[-400:]}")
            receipt = out.read_bytes()
            ans = post("/api/submit", {"range": res, "pubkey": pub, "handle": handle,
                                       "sig": sk.sign(receipt).hex(),
                                       "receipt": base64.b64encode(receipt).decode()})
            if ans.get("ok"):
                print(f"✓ {res}: folded and verified on the board as '{handle}'.")
                done += 1
            elif "already proven" in str(ans.get("error", "")):
                print(f"  {res} was folded by someone else first — discarded, no harm done.")
            else:
                print(f"✗ {res} rejected: {ans.get('error')}")
                break
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if done:
        print(f"folded {done} pair(s).")

# How long a spine run trusts its copy of /api/vranges before fetching it again. The fold tree grows
# while the spine walks, and a stale copy only ever costs width (the single block is always offered),
# so this is about noticing new wide ranges, not about correctness.
SPINE_VRANGES_TTL = float(os.environ.get("HAZYNC_SPINE_VRANGES_TTL", "300"))

def spine_index(vranges):
    """`/api/vranges` -> {lo: [(hi, proof path), ...] widest first}, multi-block ranges only.

    Only entries the coordinator serves a receipt for (a `/api/proof/` link) count. Anything else in
    the list is skipped rather than trusted, because the path is fetched verbatim."""
    idx = {}
    for r in vranges or ():
        try:
            lo, hi, path = int(r["lo"]), int(r["hi"]), str(r.get("proof") or "")
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
        if hi > lo and path.startswith("/api/proof/"):
            idx.setdefault(lo, {})[hi] = path
    return {lo: sorted(d.items(), reverse=True) for lo, d in idx.items()}

def spine_chunks(index, nxt):
    """The chunks the spine can absorb at block `nxt`, widest first, as (hi, proof path).

    `extend-spine` takes `[1..N] + [N+1..M]` for ANY M, and costs the same whatever the width: the
    guest verifies two succinct receipts and checks the seam, it never re-proves a block. So the
    widest verified range starting at N+1 (usually a node of the fold tree) moves the spine M-N
    blocks for the price of one. The single block always comes LAST, by the path that worked before
    this existed, so a wide chunk that will not absorb costs one attempt, never the spine's progress.
    """
    return list(index.get(nxt, ())) + [(nxt, f"/api/proof/{nxt}")]

def cmd_spine(args):
    """Advance the genesis-anchored spine: `spine [1..N] + [N+1..M] -> [1..M]`, repeatedly (#30).

    This is the ONE serial job in the system. Proving is embarrassingly parallel and folding is
    opportunistic, but only the leftmost range can be anchored, because anchoring means lo == 1.

    It is also the cheap job: absorption folds two receipts and checks a seam, it does not re-prove
    anything. Everything it consumes already exists — the retained per-block receipts (G1) and the
    fold tree built from them — so a spine can be rebuilt from scratch by anyone without re-proving a
    single block. Whoever runs this is a liveness single point of failure, never a soundness one.

    Each step absorbs the WIDEST verified chunk that starts where the spine ends (`spine_chunks`).
    It used to absorb one block per step whatever was available, so the one serial job ran at one
    fold per block: ~92 blocks/hr sharing a card, ~230/hr on its own, against ~2,500/hr proven
    (measured 2026-09-11), while the fold tree it could have swallowed whole sat beside it. Now the
    spine moves as fast as folding does, and folding spreads across as many cards as there are.
    """
    if not HOSTBIN:
        sys.exit("no prover binary found — `hazync spine` folds receipts, which is a prove operation.\n"
                 "  Download one from https://github.com/bitcoin-ghost/hazync/releases/latest\n"
                 "  or set HAZYNC_HOST=/path/to/host.")
    want = int(args[0]) if args and args[0].isdigit() else None
    sk, pub, handle = identity()
    work = RCPTDIR / ".spine-work"
    shutil.rmtree(work, ignore_errors=True); work.mkdir(parents=True, exist_ok=True)

    def submit_head(path, absorbed_to):
        """-> "ok", "ahead" (another extender got there first), "unsupported", or "rejected"."""
        receipt = path.read_bytes()
        res = post("/api/spine", {"pubkey": pub, "handle": handle, "sig": sk.sign(receipt).hex(),
                                  "receipt": base64.b64encode(receipt).decode()})
        if res.get("ok"):
            print(f"✓ spine now [1..{absorbed_to}] — genesis-anchored, {len(receipt)} bytes, as '{handle}'.")
            return "ok"
        err = str(res.get("error", ""))
        # "not found" here is the coordinator lacking /api/spine, not a judgement on the receipt.
        # Reporting it as "submission rejected" tells a contributor their proof was refused when
        # nothing of the sort happened — the server simply predates this feature.
        if err.strip().lower() in ("not found", "404"):
            print("this coordinator does not support the spine yet (POST /api/spine -> 404).\n"
                  "  The endpoint ships in v0.13.0 but has to be deployed on the coordinator side.\n"
                  "  Nothing is wrong with your setup or your receipt.")
            return "unsupported"
        if "does not advance" in err:
            # Benign race: another extender got there first. Not a failure — duplicate spine work is
            # harmless by design, and their head is at least as long as ours.
            print(f"  another extender is ahead ({err}) — nothing to do.")
            return "ahead"
        print(f"✗ spine submission rejected: {err}")
        return "rejected"

    index, index_at = {}, None

    def chunks_at(nxt):
        nonlocal index, index_at
        if index_at is None or time.monotonic() - index_at >= SPINE_VRANGES_TTL:
            try:
                index = spine_index(json.loads(get("/api/vranges")).get("vranges"))
            except SystemExit:
                raise
            except Exception as e:
                # An older coordinator or a hiccup: absorb one block at a time, exactly as before.
                print(f"  could not read /api/vranges ({e}) — absorbing one block at a time for now")
                index = {}
            index_at = time.monotonic()
        return spine_chunks(index, nxt)

    done = blocks = 0
    try:
        while want is None or done < want:
            head = None
            try:
                head = json.loads(get("/api/spine"))
            except SystemExit:
                raise
            except Exception:
                head = None

            if not (head and "hi" in head):
                # Bootstrap: no spine yet, so the first head IS the [1..1] receipt — already
                # genesis-anchored, it becomes the head with no fold at all.
                try:
                    chunk_bytes = get("/api/proof/1")
                except Exception:
                    print("  block 1 is not proven yet — nothing to absorb.")
                    break
                chunk = work / "chunk_1.bin"; chunk.write_bytes(chunk_bytes)
                print(f"no spine yet — seeding it with the block 1 receipt ({len(chunk_bytes)} bytes)")
                if submit_head(chunk, 1) != "ok":
                    break
                done += 1; blocks += 1
                continue

            was = int(head["hi"]); nxt = was + 1
            cur = work / "spine_head.bin"
            cur.write_bytes(get("/api/spine/proof"))
            outcome, fetched = None, False
            cands = chunks_at(nxt)
            for i, (hi, path) in enumerate(cands):
                narrower = i + 1 < len(cands)
                # The chunk is a retained receipt from the board — nothing is re-proved here.
                try:
                    chunk_bytes = get(path)
                except Exception:
                    continue          # not served; for the single block, that means not proven yet
                fetched = True
                span = f"[{nxt}..{hi}]" if hi > nxt else f"block {nxt}"
                chunk = work / f"chunk_{nxt}_{hi}.bin"; chunk.write_bytes(chunk_bytes)
                out = work / f"spine_{hi}.bin"
                print(f"absorbing {span} into [1..{was}] — one fold, no re-proving…")
                with gpu_lock("absorb"):
                    r = subprocess.run([HOSTBIN, "extend-spine", str(cur), str(chunk), str(out)],
                                       capture_output=True, text=True)
                if r.returncode != 0 or not out.exists():
                    both = (r.stdout or "") + (r.stderr or "")
                    # hazync#220: a LOST RACE looks exactly like a guest mismatch, and the host's advice
                    # ("build a host that matches the proof's guest") sends you after a cause that is not
                    # there. Two spine workers against one spine is the usual way in: we fetched the head,
                    # waited on the GPU lock, and by the time the fold ran the head had moved — so the
                    # claim digest no longer matched a head that no longer exists.
                    #
                    # The two cases are distinguishable, and this is the only place that can tell them
                    # apart, because only the caller knows which head the fold was computed against.
                    # A genuine guest mismatch is deterministic; a lost race self-heals on the next pass.
                    moved = None
                    try:
                        now = json.loads(get("/api/spine"))
                        if now and "hi" in now:
                            moved = int(now["hi"])
                    except Exception:
                        moved = None
                    if moved is not None and moved != was:
                        # Not an error. The other worker did the work we were about to do.
                        print(f"  the spine advanced under us while this fold ran "
                              f"([1..{was}] -> [1..{moved}]) — refolding from the new head")
                        outcome = "moved"
                        break
                    if narrower:
                        # A wide chunk that will not absorb (the host checks the seam before the GPU
                        # runs, so this is cheap). Fall back to a narrower one rather than stall; the
                        # single block, last in the list, is the path that worked before.
                        last = (both.strip().splitlines() or ["no output"])[-1][:160]
                        print(f"  {span} would not absorb ({last}) — trying a narrower chunk")
                        continue
                    # Head unchanged, so the host's build-mismatch advice is now actually the likely
                    # cause, and a seam failure here is information rather than noise.
                    sys.exit(f"extend-spine failed for {span}:\n{both[-400:]}")
                outcome = submit_head(out, hi)
                if outcome == "rejected" and narrower:
                    print(f"  trying a narrower chunk than {span}")
                    continue
                if outcome == "ok":
                    done += 1; blocks += hi - nxt + 1
                break
            if outcome == "moved":
                continue
            if outcome is None:
                if fetched:
                    print(f"  nothing starting at block {nxt} would absorb — stopping at [1..{was}].")
                else:
                    print(f"  block {nxt} is not proven yet (no retained receipt) — the spine is up to "
                          f"date at [1..{was}].")
                break
            if outcome != "ok":
                break
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if done:
        print(f"absorbed {blocks} block(s) into the spine in {done} step(s).")

def main():
    # No signal handlers any more. They existed to hand a CLAIM back on SIGTERM, because Python's
    # default SIGTERM kills the interpreter outright and an orphaned claim then stalled the board
    # until a ~30 minute reap. Free-running proving has nothing to hand back: a worker that dies
    # mid-block leaves no state at all, and the block is simply still unproven.
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); sys.exit(0 if argv else 1)   # explicit --help succeeds; a bare invocation is an error
    c, a = argv[0], argv[1:]
    fn = {"id": cmd_id, "pick": cmd_pick, "prove": cmd_prove, "selftest": cmd_selftest,
          "submit": cmd_submit, "run": cmd_run, "spine": cmd_spine, "fold": cmd_fold,
          "rotate": cmd_rotate}.get(c)
    if not fn:
        print(f"unknown command '{c}'\n"); print(__doc__); sys.exit(1)
    if c in ("claim", "prove", "submit") and not a:  # these require a range; don't traceback on a bare call
        sys.exit(f"usage: hazync {c} <range>   (e.g. hazync {c} 1000-1999)")
    fn(a)

if __name__ == "__main__":
    main()
