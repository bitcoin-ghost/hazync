#!/usr/bin/env python3
"""
hazync — Proof Party contributor CLI.

  hazync id                 # create/show your signing identity (ed25519)
  hazync pick               # ask the coordinator for the next OPEN range (near the frontier)
  hazync claim <id>         # reserve an open range from the board (e.g. 0-999)
  hazync prove <id>         # prove that range on your GPU  -> a receipt .bin
  hazync submit <id>        # sign the receipt with your key and submit it for verification
  hazync run [id]           # claim + prove + submit, end to end (id optional: picks the next open range)
  hazync selftest           # pre-flight: prover present, guest id matches, can verify a real proof

The party proves the chain forward from genesis, so you take a range near the current
frontier. The coordinator serves a ready-made witness bundle for each block in its window,
so you prove a block directly — no need to run your own node or replay the chain. An
arbitrary far-future block (past the served window) is not something a fresh contributor
can prove yet.

Config (env):
  COORD_URL   coordinator base URL   (default http://localhost:8899;
              the public party is https://bitcoinghost.org/hazync)
  HAZYNC_HOST path to the prover `host` binary (required for `prove`/`run`)
  BUNDLE_DIR  where fetched archive bundles live (default ~/.hazync/bundles)
  WITNESS_DIR legacy per-block witnesses, replay fallback (default ~/.hazync/witnesses)
Identity + receipts live under ~/.hazync/.
"""
import os, sys, json, base64, subprocess, urllib.request, urllib.error, pathlib, threading, time, shutil
import signal
import concurrent.futures

HOME    = pathlib.Path(os.path.expanduser("~/.hazync"))
KEY     = HOME / "key.hex"
HANDLE  = HOME / "handle"
RCPTDIR = HOME / "receipts"
COORD   = os.environ.get("COORD_URL", "http://localhost:8899").rstrip("/")
HOSTBIN = os.environ.get("HAZYNC_HOST", "")
WITNESS = os.environ.get("WITNESS_DIR", str(HOME / "witnesses"))
BUNDLES = os.environ.get("BUNDLE_DIR", str(HOME / "bundles"))   # archive-node bundles fetched from the coordinator

def _ed():
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
        from cryptography.hazmat.primitives import serialization
    except ImportError:
        sys.exit("missing the signing library `cryptography`. Install it:\n"
                 "  sudo apt install python3-cryptography      # Debian/Ubuntu\n"
                 "  or:  pip install cryptography")
    return Ed25519PrivateKey, serialization

def identity():
    HOME.mkdir(parents=True, exist_ok=True); RCPTDIR.mkdir(exist_ok=True)
    Ed25519PrivateKey, ser = _ed()
    if KEY.exists():
        sk = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(KEY.read_text().strip()))
    else:
        sk = Ed25519PrivateKey.generate()
        KEY.write_text(sk.private_bytes(ser.Encoding.Raw, ser.PrivateFormat.Raw, ser.NoEncryption()).hex())
        KEY.chmod(0o600)
    pub = sk.public_key().public_bytes(ser.Encoding.Raw, ser.PublicFormat.Raw).hex()
    handle = HANDLE.read_text().strip() if HANDLE.exists() else ("ghost:" + pub[:6])
    return sk, pub, handle

def _open(req, timeout, tries=4):
    # Open a request with a timeout and retry on TRANSIENT network errors only — a real HTTP response
    # (4xx/5xx, incl. 409 already-claimed / 404 no-witness) is returned to the caller, never retried.
    # Without this a single flaky request hangs the whole CLI (the old no-timeout behaviour).
    for k in range(tries):
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError:
            raise                                        # server answered — let the caller handle it
        except (urllib.error.URLError, OSError) as e:    # connection refused / reset / timeout
            if k + 1 >= tries:
                raise SystemExit(f"coordinator {COORD} unreachable after {tries} tries: {e}")
            time.sleep(2 * (k + 1))                       # 2s, 4s, 6s backoff

def post(path, body):
    req = urllib.request.Request(COORD + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"})
    try:
        return json.load(_open(req, timeout=180))        # submit triggers verification — allow time
    except urllib.error.HTTPError as e:                  # coordinator returns JSON {"error": ...} with a 4xx/5xx
        try: return json.loads(e.read().decode())
        except Exception: raise SystemExit(f"coordinator error {e.code}: {e.reason}")

def get(path):
    return _open(urllib.request.Request(COORD + path), timeout=60).read()

def witness_in_window(blk):
    # True if the coordinator currently serves the witness for `blk` (i.e. the block is inside the rolling
    # window a fresh contributor can prove). A cheap pre-flight so `run` never claims a range it can't fetch.
    try:
        get(f"/api/witness/{blk}"); return True
    except urllib.error.HTTPError:
        return False

def fetch_witnesses(lo, hi):
    # the prover replays blocks 1..hi to rebuild the accumulator, so it needs every witness up to hi.
    # pull any we don't already have from the coordinator's rolling window.
    os.makedirs(WITNESS, exist_ok=True)
    for i in range(1, hi + 1):
        wf = os.path.join(WITNESS, f"block_{i}.json")
        if os.path.exists(wf):
            continue
        try:
            data = get(f"/api/witness/{i}")
        except Exception as e:
            sys.exit(f"could not fetch witness for block {i} from {COORD}: {e}")
        with open(wf, "wb") as fh:
            fh.write(data)

def fetch_bundles(lo, hi):
    # Fetch an archive-node bundle for every block in [lo..hi]. Returns True iff all are available (the
    # bridge path — prove with NO replay); False if any block is missing or only a legacy per-block witness
    # exists, in which case the caller falls back to the replay path. A bundle carries in_roots + witness.
    os.makedirs(BUNDLES, exist_ok=True)
    for h in range(lo, hi + 1):
        bf = os.path.join(BUNDLES, f"bundle_{h}.json")
        if os.path.exists(bf):
            continue
        try:
            data = get(f"/api/witness/{h}")
            j = json.loads(data)
        except Exception:
            return False
        if "in_roots" not in j or "witness" not in j:
            return False                       # legacy per-block witness, not a bridge bundle
        with open(bf, "wb") as fh:
            fh.write(data)
    return True

def parse_range(rng):
    # "N" -> (N, N); "lo-hi" -> (lo, hi). Exits with a clear message on anything else.
    try:
        p = [int(x) for x in rng.split("-")]
    except ValueError:
        p = []
    if len(p) == 1:
        return p[0], p[0]
    if len(p) == 2 and p[1] >= p[0]:
        return p[0], p[1]
    sys.exit(f"invalid range '{rng}' — use 'N' (one block) or 'lo-hi' (e.g. 1000-1999)")

def cmd_id(args):
    _, pub, handle = identity()
    if args: HANDLE.write_text(args[0]); handle = args[0]
    print("handle :", handle); print("pubkey :", pub); print("coord  :", COORD)
    print("(set a handle:  hazync id <name>)")

def cmd_pick(args):
    r = json.loads(get("/api/pick"))
    if r.get("range"):
        print("next open range:", r["range"], "  (claim it:  hazync run", r["range"] + ")")
    else:
        print(r.get("note", "nothing open"))
    return r.get("range")

def cmd_claim(args):
    rng = args[0]; _, pub, handle = identity()
    res = post("/api/claim", {"range": rng, "pubkey": pub, "handle": handle})
    if res.get("ok"):
        print(f"claimed {rng}"); return
    print(f"could not claim {rng}: {res.get('error') or res}"); sys.exit(1)

def _heartbeat(rng, pub, stop):
    # keep the claim alive while proving — ping the coordinator every 30s
    while not stop.wait(30):
        try: post("/api/heartbeat", {"range": rng, "pubkey": pub})
        except Exception: pass

def _release(rng, pub, err=None):
    # A prove/submit failed after we claimed — hand the block back to the pool now, so it reopens in
    # seconds instead of sitting `claimed` until the coordinator's CLAIM_TTL reap (~30m). Best-effort:
    # the server-side reap is the backstop if this call can't get through (e.g. the box lost the network).
    #
    # The reason travels with the release so the coordinator can record it against the range. Without it
    # a parked block says only "failed 3 times" and the operator has to go log-diving on whichever box
    # happened to hold it — which does not work once the logs have rotated.
    body = {"range": rng, "pubkey": pub}
    if err: body["error"] = str(err)[:500]
    try: post("/api/release", body)
    except Exception: pass

# Failures that smaller proving segments cannot fix — a bad/mismatched bundle, a guest-id mismatch, a
# missing input. When the host dies on one of these, surface the real error at once instead of burning all
# three retries and hiding it behind "failed to prove" (that masking cost real debugging time on the
# v0.9.0 bundle-parse bug — the true cause, "parse bundle: invalid type: sequence", was buried).
_HARD_ERR = ("parse bundle", "invalid type", "deserialize", "missing field", "METHOD_ID", "image id",
             "read bundle", "No such file", "no such file")

_SEG_MIN = 18                                       # below this the segments stop repartitioning usefully
_SEG_TOP_CACHE = {"v": False}                       # False = not yet asked (None is a valid answer)

def _seg_ladder(env):
    # [first attempt, then every smaller size down to _SEG_MIN]. The first attempt is None = "let the
    # binary (or the operator's HAZYNC_SEG_PO2) decide"; the rest walk down from whatever that was, with
    # no duplicate rung. Falls back to the old fixed ladder if the binary predates `seg-po2`.
    if env.get("HAZYNC_SEG_PO2", "").isdigit():
        top = int(env["HAZYNC_SEG_PO2"])
    else:
        if _SEG_TOP_CACHE["v"] is False:             # ask the binary once per run, not once per block
            _SEG_TOP_CACHE["v"] = None
            try:
                r = subprocess.run([HOSTBIN, "seg-po2"], capture_output=True, text=True, timeout=30)
                if r.returncode == 0 and r.stdout.strip().isdigit():
                    _SEG_TOP_CACHE["v"] = int(r.stdout.strip())
            except Exception:
                pass
        top = _SEG_TOP_CACHE["v"]
    if top is None:
        return (None, 20, 19, 18)
    return (None, *range(top - 1, _SEG_MIN - 1, -1))

# Lines that carry no information about WHY something failed. `note: run with RUST_BACKTRACE=1` is
# almost always the LAST line rustc-built binaries emit, so taking splitlines()[-1] — as this did —
# reliably captured the one line that says nothing.
#
# That was not merely unhelpful. The reason travels to the coordinator with the release and is what
# decides whether a failure is environmental (OOM, capacity) or block-implicating: an out-of-memory
# recorded as "note: run with RUST_BACKTRACE=1" is invisible to that classifier, so a capacity blip
# would be counted against the block and could park perfectly good work.
_NOISE = ("note:", "stack backtrace", "run with `rust_backtrace", "warning:")

def _err_tail(stderr, keep=4):
    """The most informative trailing lines of a failed prove, noise dropped."""
    lines = [l.strip() for l in (stderr or "").splitlines() if l.strip()]
    signal = [l for l in lines if not any(n in l.lower() for n in _NOISE)]
    picked = (signal or lines)[-keep:]
    return " | ".join(picked) if picked else "(no error output)"

def _run_with_seg_retry(argv, env, work, label):
    # risc0 4.0.5 panics on ~10% of workloads (a preflight segment-boundary bug) — on CPU AND cuda, and on
    # EVERY prove path (single-block prove-range/-bridge AND fold-range). Retry with progressively smaller
    # proving segments; smaller segments repartition the work and clear the boundary, and the receipt is
    # identical (guest unchanged, METHOD_ID unchanged), so it's transparent.
    #
    # The ladder STARTS at the binary's own default rather than a hardcoded number: `host seg-po2` reports
    # 21 for a cuda build and 20 for CPU (a po2-21 segment needs ~2x the working memory — a win on a GPU,
    # a pure cost on a RAM-limited CPU box). Hardcoding the top rung would override that per-backend choice
    # and, on CPU, waste a full duplicate prove attempt at a size that just failed. An operator's explicit
    # HAZYNC_SEG_PO2 wins the first attempt for the same reason.
    last = ""
    for _po2 in _seg_ladder(env):
        _env = dict(env) if _po2 is None else dict(env, HAZYNC_SEG_PO2=str(_po2))
        r = subprocess.run([HOSTBIN, *argv], env=_env,
                           cwd=work, stderr=subprocess.PIPE, text=True)
        if r.stderr:                                    # keep the host's real output in the worker log
            sys.stderr.write(r.stderr); sys.stderr.flush()
        if r.returncode == 0:
            return
        last = (r.stderr or "").strip()
        if any(h in last for h in _HARD_ERR):           # smaller segments won't help — fail fast, loudly
            tail = _err_tail(last)
            sys.exit(f"{label}: {tail}\n(not a segment-size issue — retrying smaller won't help; check the "
                     f"bundle/witness and that `host method-id` matches reproduce/METHOD_ID)")
    sys.exit(f"{label} failed to prove even at reduced segment size (SEG_PO2=18) — last error: {_err_tail(last)}")

def cmd_prove(args):
    rng = args[0]
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("set HAZYNC_HOST to the prover `host` binary (needs a GPU box + witnesses in WITNESS_DIR)")
    _, pub, _ = identity()
    lo, hi = parse_range(rng)                            # "n" (single block) or "lo-hi" (range)
    RCPTDIR.mkdir(parents=True, exist_ok=True)
    out = RCPTDIR / f"{rng}.bin"
    # Prove + fold in a dedicated per-range work dir (under ~/.hazync) so the host's range_*.bin /
    # fold_*.bin intermediates never litter the CWD, never collide with a concurrent prove, and the final
    # os.replace stays on one filesystem (no EXDEV).
    work = RCPTDIR / f".work-{rng}"
    shutil.rmtree(work, ignore_errors=True); work.mkdir(parents=True, exist_ok=True)
    # Block 0 is the genesis anchor and is unprovable, so we start at max(lo, 1). The genesis-seed slot
    # 0-999 is thus proved as blocks 1..999; the coordinator (which pins the genesis in-boundary) accepts
    # a [1..hi] receipt for a [0..hi] claim. Starting at 1 also means a bad manual `run 0-...` no longer
    # crashes on `prove-range 0`.
    start = max(lo, 1)
    # Prefer the archive-node bridge: if the coordinator serves a ready-made bundle for every block in the
    # range, prove each with NO replay (O(1)/block). Otherwise fall back to the replay path, which rebuilds
    # the accumulator from genesis and so needs every witness up to hi.
    if fetch_bundles(start, hi):
        env = dict(os.environ, HAZYNC_BRIDGE_OUT=BUNDLES)
        prove_cmd = "prove-range-bridge"
        print(f"using archive-node bundles (no replay) for blocks {start}..{hi}")
    else:
        fetch_witnesses(start, hi)                    # pull any witnesses we're missing from the coordinator
        env = dict(os.environ, HAZYNC_WITNESS_DIR=WITNESS)
        prove_cmd = "prove-range"
        print(f"archive bundles unavailable — replaying from genesis for blocks {start}..{hi}")
    stop = threading.Event()
    threading.Thread(target=_heartbeat, args=(rng, pub, stop), daemon=True).start()  # keep the claim alive
    try:
        total = hi - start + 1
        print(f"proving range {rng} ({total} block{'s' if total != 1 else ''}) on your GPU — the expensive step; heartbeating the claim…")
        parts = []
        for i, h in enumerate(range(start, hi + 1), 1):
            _run_with_seg_retry([prove_cmd, str(h)], env, work, f"block {h}")
            parts.append(f"range_{h}.bin")
            if total > 1 and (i % 50 == 0 or i == total):
                print(f"  …proved {i}/{total} blocks — the board frontier advances once the whole range is proved + submitted", flush=True)
        _fold_and_save(parts, out, work, env)
        print("receipt:", out)
    finally:
        stop.set()
        shutil.rmtree(work, ignore_errors=True)          # drop the range_*/fold_* intermediates

def _fold_conc():
    # Folds WITHIN a tree level are mutually independent (nothing at level N depends on anything else at
    # level N), so they can run concurrently. Default 1 — i.e. unchanged behaviour — because the bound is
    # GPU VRAM and overcommitting does not degrade gracefully: it OOMs mid-fold in `hash_rows`.
    #
    # Measured on a 46 GB L40S with the board paused (#27):
    #   K=1  3.00 s/fold   peak  8,949 MiB
    #   K=2  2.00 s/fold   peak 11,742 MiB   <- 1.5x, safe
    #   K=4  OOM ("Failure during hash_rows ... out of memory"), peak 40,649 MiB
    # A single fold already drives the GPU to 100% utilisation, so the win is scheduling-gap sized, not
    # linear in K. Raise this deliberately, per box — there is no safe auto-detect across card sizes.
    try:
        v = int(os.environ.get("HAZYNC_FOLD_CONCURRENCY", "1"))
    except ValueError:
        v = 1
    return max(1, v)

def _fold_level(parts, rnd, work, env, conc):
    # One level of the fold tree. Returns the next level's parts, preserving order (order matters: fold
    # seams must stay adjacent, so parts[i] and parts[i+1] must remain neighbours in the result).
    jobs, nxt = [], []
    for i in range(0, len(parts), 2):
        if i + 1 < len(parts):
            m = f"fold_r{rnd}_{i}.bin"
            jobs.append((m, parts[i], parts[i + 1]))
            nxt.append(m)
        else:
            nxt.append(parts[i])                      # odd one out is carried up untouched
    if not jobs:
        return nxt

    def _one(job):
        m, a, b = job
        try:
            _run_with_seg_retry(["fold-range", a, b, m], env, work, f"fold {a}+{b}")
        except SystemExit as e:
            # _run_with_seg_retry exits the process on failure. Inside a worker thread that would only
            # kill the thread and let the level "succeed" with a missing receipt, so it must become a
            # value we can act on.
            return str(e.code)
        return None

    if conc <= 1:
        for j in jobs:                                 # serial path unchanged — no pool, no threads
            err = _one(j)
            if err:
                sys.exit(err)
        return nxt

    errs = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=conc) as ex:
        for err in ex.map(_one, jobs):
            if err:
                errs.append(err)
    if errs:
        # Fail the whole level rather than proceeding with a hole in it: a partial level would fold
        # non-adjacent ranges together at the next level and produce a receipt with a bogus seam.
        sys.exit(f"{len(errs)} of {len(jobs)} folds failed at level {rnd}; first error:\n{errs[0]}")
    return nxt

def _fold_and_save(parts, out, work, env):
    # Recursively fold the per-block receipts into one; all I/O is inside `work` (cwd=work). fold-range hits
    # the same risc0 segment-boundary bug as the block prove, so it goes through the same seg-retry path.
    conc = _fold_conc()
    rnd = 0
    while len(parts) > 1:
        rnd += 1
        before, t0 = len(parts), time.time()
        parts = _fold_level(parts, rnd, work, env, conc)
        print(f"  …folding into one receipt: {before} → {len(parts)}"
              f"  ({time.time() - t0:.0f}s, concurrency {conc})", flush=True)
    os.replace(os.path.join(work, parts[0]), out)

def cmd_submit(args):
    rng = args[0]; sk, pub, handle = identity()
    f = RCPTDIR / f"{rng}.bin"
    if not f.exists(): sys.exit(f"no receipt at {f} — run `hazync prove {rng}` first")
    receipt = f.read_bytes()
    sig = sk.sign(receipt).hex()
    res = post("/api/submit", {"range": rng, "pubkey": pub, "handle": handle,
                               "sig": sig, "receipt": base64.b64encode(receipt).decode()})
    if res.get("ok"):
        print(f"✓ range {rng}: the coordinator re-verified your proof and put it on the board as '{handle}'.")
        sys.exit(0)
    if "already proven" in str(res.get("error", "")):
        # Benign race: another prover landed this block first. Not a failure — don't alarm the contributor
        # (and cmd_run, seeing exit 0, won't release: the block is already verified).
        print(f"✓ range {rng} was already proved by someone else — nothing to do.")
        sys.exit(0)
    print("✗ submit rejected:", res.get("error") or res)
    sys.exit(1)

def cmd_selftest(args):
    # One command a contributor runs BEFORE committing a GPU to real work: confirm the prover is present,
    # its guest id matches this coordinator (else every submit is rejected), and it can actually verify a
    # real board proof end to end. Catches the common "built a different guest" trap up front.
    print("hazync selftest — checking your setup before you claim real work\n")
    ok = True
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("✗ HAZYNC_HOST is not set to a prover binary.\n"
                 "  Download it from https://github.com/bitcoin-ghost/hazync/releases/latest and\n"
                 "  export HAZYNC_HOST=/path/to/host")
    print(f"✓ prover binary present: {HOSTBIN}")
    try:
        r = subprocess.run([HOSTBIN, "method-id"], capture_output=True, text=True, timeout=30)
        mine = next((t for t in r.stdout.split() if len(t) == 64 and all(c in "0123456789abcdef" for c in t)), None)
    except Exception as e:
        sys.exit(f"✗ could not run `{HOSTBIN} method-id`: {e}")
    if not mine:
        sys.exit("✗ `host method-id` printed no image id — is this the hazync host binary?")
    print(f"✓ your guest METHOD_ID: {mine}")
    try:
        want = json.loads(get("/api/meta")).get("method_id")
    except Exception as e:
        print(f"! could not reach {COORD}/api/meta to compare ids ({e}) — skipping the match check"); want = None
    if want and want == mine:
        print("✓ matches the coordinator — your proofs will be accepted")
    elif want:
        print(f"✗ METHOD_ID MISMATCH — the coordinator expects {want}.\n"
              "  You built a different guest, so every proof would be rejected. Use the prebuilt release\n"
              "  binary, or the reproducible build (reproduce/Dockerfile). (Nothing was claimed.)")
        ok = False
    try:
        proof = get("/api/proof/1")
        RCPTDIR.mkdir(parents=True, exist_ok=True)
        pf = RCPTDIR / "selftest_proof.bin"; pf.write_bytes(proof)
        vr = subprocess.run([HOSTBIN, "verify-any", str(pf)], capture_output=True, text=True, timeout=120)
        try: pf.unlink()
        except OSError: pass
        if vr.returncode == 0 and any(l.startswith("RANGE-OK") for l in vr.stdout.splitlines()):
            print("✓ verified a real board proof end to end (verify-any → RANGE-OK)")
        else:
            print(f"✗ verify-any failed: {(vr.stdout + vr.stderr).strip()[-200:]}"); ok = False
    except Exception as e:
        print(f"! could not fetch/verify a sample proof ({e}) — skipping the verify check")
    print()
    if ok:
        print("ALL GOOD — you're ready. Claim work with `hazync run`.")
    else:
        sys.exit("SETUP INCOMPLETE — fix the ✗ items above before `hazync run`.")

def cmd_run(args):
    # Check the prover binary FIRST — `run` claims a range (locking it under the claim TTL), so we must
    # not claim only to bail later because HAZYNC_HOST is unset. (cmd_prove re-checks; this is the gate.)
    if not HOSTBIN or not os.path.exists(HOSTBIN):
        sys.exit("set HAZYNC_HOST to the prover `host` binary before `run` — download it from "
                 "https://github.com/bitcoin-ghost/hazync/releases/latest and `export HAZYNC_HOST=/path/to/host`.")
    if args:
        # Explicit range: fail fast BEFORE claiming — the whole range must be inside the coordinator's served
        # window (block 0 is unprovable, so clamp to 1) so a claim never locks a range we then can't fetch.
        lo, hi = parse_range(args[0])
        for probe in sorted({max(lo, 1), hi}):
            if not witness_in_window(probe):
                sys.exit(f"range {args[0]} is outside the coordinator's served window (block {probe} has no "
                         f"witness yet) — nothing was claimed. Pick an in-window range with `hazync pick`.")
        cmd_claim(args); rng = args[0]
    else:
        # No range given — ATOMIC claim-next: the coordinator picks the next open window (incl the genesis
        # window) AND locks it in one step under its lock, so parallel `hazync run` workers never race onto
        # the same range (the old pick-then-claim left a window where two workers grabbed the same one).
        _, pub, handle = identity()
        res = post("/api/claim", {"range": "next", "pubkey": pub, "handle": handle})
        if not res.get("ok"): sys.exit(f"nothing to claim: {res.get('error') or res}")
        rng = res["range"]; print(f"claimed {rng}")
    # From here the range is claimed. If prove or submit fails, release the claim before exiting so the
    # block reopens immediately (a failed prove used to leave it `claimed` — an orphaned hole that stalled
    # the genesis frontier until the ~30m reap). cmd_submit exits 0 on success (no release on the happy path).
    _, pub, _h = identity()
    try:
        cmd_prove([rng]); cmd_submit([rng])
    except SystemExit as e:
        if e.code not in (0, None):                      # non-zero / message exit == failure after claiming
            _release(rng, pub, e.code)                   # carry the real reason to the coordinator
        raise
    except BaseException as e:                           # Ctrl-C or an unexpected error — hand it back too
        _release(rng, pub, f"{type(e).__name__}: {e}"); raise

def _on_term(signum, _frame):
    # Turn SIGTERM into a normal Python exception so the claim gets HANDED BACK.
    #
    # Python's default SIGTERM handling kills the interpreter outright: no `finally`, no `except`, so
    # cmd_run's release-on-failure path never runs and the claim is orphaned until the coordinator's
    # ~30m CLAIM_TTL reap. Since the frontier is the lowest unproven block, one orphaned claim stalls
    # the whole board — and every routine `pkill` in restart_workers_v10.sh created one. Observed
    # repeatedly on 2026-07-28: block 35519 sat `claimed` with a dead heartbeat for 19 minutes after a
    # worker restart, with all of its neighbours already verified.
    raise KeyboardInterrupt(f"received signal {signum}")

def main():
    for _sig in ("SIGTERM", "SIGINT", "SIGHUP"):
        try: signal.signal(getattr(signal, _sig), _on_term)
        except (AttributeError, ValueError): pass    # not all platforms/threads allow every signal
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); sys.exit(0 if argv else 1)   # explicit --help succeeds; a bare invocation is an error
    c, a = argv[0], argv[1:]
    fn = {"id": cmd_id, "pick": cmd_pick, "claim": cmd_claim, "prove": cmd_prove, "selftest": cmd_selftest,
          "submit": cmd_submit, "run": cmd_run}.get(c)
    if not fn:
        print(f"unknown command '{c}'\n"); print(__doc__); sys.exit(1)
    if c in ("claim", "prove", "submit") and not a:  # these require a range; don't traceback on a bare call
        sys.exit(f"usage: hazync {c} <range>   (e.g. hazync {c} 1000-1999)")
    fn(a)

if __name__ == "__main__":
    main()
