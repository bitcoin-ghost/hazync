[Unit]
Description=Hazync: copy the bridge's checkpoint rungs to Cloudflare R2 (append-only)
Documentation=https://github.com/bitcoin-ghost/hazync/issues/386
After=network-online.target hazync-coordinator.service
Wants=network-online.target
OnFailure=hazync-alert@%n.service

[Service]
Type=oneshot
# WHY (hazync#386). prune_bundles.py will not delete a bundle unless an archived rung below it exists to
# rebuild from — that is the entire safety argument for pruning. The rungs lived only on /srv/bulk, which
# no offsite unit touched, so the thing authorising deletion was itself single-copy. Losing a rung makes
# the bundles pruned against it unrebuildable, and nothing would notice until someone tried.
#
# The LOWEST rung matters most: regeneration seeds from the nearest rung strictly BELOW its target, so the
# lowest one bounds what can be rebuilt at all. The job exits 1 if that one is missing remotely even when
# every other rung is present, so this unit fails and alerts.
#
# ⛔ TimeoutStartSec is hours, not the 5min the spine unit uses. A rung is ~0.5-9 GB and the archive is
# 9.3 GB today, heading for ~100 GB once the backfill lands (hazync#379); at the 64 Mbit/s cap that is a
# multi-hour first run. It is append-only, so a timeout mid-run costs nothing but a retry.
# Root only for reading the root-only key file.
ExecStart=/usr/local/sbin/hazync-offsite-proofs checkpoints --keys /etc/hazync/backup/r2.keys --bucket hazync-proofs --min-age 1800 --threads 4 --bwlimit-mbit 64
TimeoutStartSec=6h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/bulk/hazync/checkpoints /opt/hazync
