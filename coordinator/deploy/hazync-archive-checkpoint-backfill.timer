[Unit]
# Companion to hazync-bridge-backfill.service (hazync#347).
#
# Cadence: the backfill checkpoints every 25,000 blocks and walks at the 0.294 s/block measured on this
# box, so a rung appears roughly every 2 hours. Hourly is comfortably inside that, and a missed run costs
# nothing because the next one still sees the rung as due.
Description=Hazync: archive backfill-walk checkpoints hourly (rung every 25,000 blocks)
Documentation=https://github.com/bitcoin-ghost/hazync/issues/347

[Timer]
# :38 keeps this clear of the offsite timers at :07 and :53, the live archiver at :23, and the nightly
# checks at 04:17 — so two multi-GB copies never start together.
# ⛔ EVERY 5 MINUTES, NOT HOURLY — MEASURED, NOT ASSUMED. The comment below was written expecting the
# 0.294 s/block average, giving a rung every ~2 hours. The walk actually starts far faster: measured
# 2026-09-18 on the live box, 230,001 -> 245,000 took 9 minutes, i.e. 0.036 s/block, so a rung every
# ~15 minutes. The bridge keeps ONE state.bin and overwrites it at each checkpoint, so an hourly poll
# would have lost roughly three rungs in four, silently — the exact never-fires failure this job exists
# to prevent. Polling is cheap: unless a rung is actually due the script exits 0 without copying.
# The rate falls as height rises, so 5 minutes only gets safer.
OnCalendar=*-*-* *:00/5:00 UTC
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
