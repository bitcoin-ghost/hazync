[Unit]
Description=Hazync Proof Party coordinator (verify-only, CPU)
After=network-online.target
Wants=network-online.target

# PATHS HERE ARE THE ONES ACTUALLY IN USE. They used to point at /opt/hazync and /root, while the
# live deployment ran entirely out of /var/lib/hazync via drop-ins in
# /etc/systemd/system/hazync-coordinator.service.d/. Nothing was broken — the drop-ins won — but this
# file is what a human reads, and it disagreed with reality. Reading it during a deploy suggested the
# coordinator was pointed at a bridge directory that does not exist, which would mean provable_tip()
# returning 0 and pick/claim handing out nothing: a plausible-looking outage that had to be chased
# down before it was safe to restart. Worse, applying this file WITHOUT the drop-ins produced a
# coordinator that could not serve a single bundle.
#
# Check what is really in force with:  systemctl show hazync-coordinator -p Environment

[Service]
Type=simple
User=hazync
Group=hazync
WorkingDirectory=/opt/hazync/coordinator
# The coordinator VERIFIES proofs on CPU (host verify-any) and serves the API + witnesses.
# No GPU needed here — proving/folding happen on contributors' boxes.
Environment=COORD_PORT=8899
Environment=COORD_DB=/var/lib/hazync/coordinator.db
Environment=COORD_STATE=/var/lib/hazync/coord_state
Environment=WITNESS_DIR=/var/lib/hazync/witnesses
# Co-located archive-node bridge: serve /api/witness/<n> straight from the bridge's bundle dir (local
# read, no cross-box copy). Leave unset to fall back to the legacy per-block witness window.
Environment=HAZYNC_BRIDGE_OUT=/var/lib/hazync/bridge_bundles
Environment=COORD_PROOFS=/var/lib/hazync/proofs
Environment=COORD_SPINE=/var/lib/hazync/spine
Environment=HAZYNC_HOST=/opt/hazync/prover/target/release/host
Environment=VERIFY_MODE=real
# A FLOOR, not the answer: the coordinator derives its ceiling from the highest bundle the bridge
# can actually serve, and only falls back to this when that is lower (a backfilling or absent bridge).
Environment=TIP_HEIGHT=958301
Environment=RANGE_SIZE=1000
Environment=SEED_RANGES=0
# Bind to localhost only — nginx on the web box reverse-proxies to it (single domain). If the web box
# is a DIFFERENT machine, bind to the private-network interface instead and firewall :8899 to it.
Environment=COORD_BIND=127.0.0.1
ExecStart=/usr/bin/python3 /opt/hazync/coordinator/server.py
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
# ProtectHome=true is NOT set. It makes /home, /root and /run/user "inaccessible and empty", and if
# the bundle directory ever sits under /root the coordinator cannot read it — failing SILENTLY,
# because can_serve_witness() probes with os.path.exists(), gets False, and falls through to the
# legacy per-block witness window. No exception, no log line. Arbitrary-height bundle serving would
# quietly stop and look like nobody submitting (hazync#60).
#
# The live bundle directory has since moved to /var/lib/hazync/bridge_bundles, which is the condition
# hazync#58 set for restoring it. Turning it on is now a one-line change plus a verification that
# /api/witness/<n> still returns 200 — but it should be its own change, tested on the box, not folded
# into a docs fix.
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/opt/hazync /var/lib/hazync

[Install]
WantedBy=multi-user.target
