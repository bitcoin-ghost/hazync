[Unit]
Description=Hazync Proof Party coordinator (verify-only, CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hazync
Group=hazync
WorkingDirectory=/opt/hazync/coordinator
# The coordinator VERIFIES proofs on CPU (host verify-any) and serves the API + witnesses.
# No GPU needed here — proving/folding happen on contributors' boxes.
Environment=COORD_PORT=8899
Environment=COORD_DB=/opt/hazync/coordinator.db
Environment=COORD_STATE=/opt/hazync/coordinator-state
Environment=WITNESS_DIR=/opt/hazync/witnesses
# Co-located archive-node bridge: serve /api/witness/<n> straight from the bridge's bundle dir (local
# read, no cross-box copy). Leave unset to fall back to the legacy per-block witness window.
Environment=HAZYNC_BRIDGE_OUT=/root/bridge_bundles
Environment=HAZYNC_HOST=/opt/hazync/prover/target/release/host
Environment=VERIFY_MODE=real
Environment=TIP_HEIGHT=958301
Environment=RANGE_SIZE=1000
Environment=SEED_RANGES=0
# Bind to localhost only — nginx on the web box reverse-proxies to it (single domain). If the web box
# is a DIFFERENT machine, bind to the private-network interface instead and firewall :8899 to it.
Environment=COORD_BIND=127.0.0.1
ExecStart=/usr/bin/python3 /opt/hazync/coordinator/server.py
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
# ProtectHome=true is NOT set, and must not be while HAZYNC_BRIDGE_OUT points into /root.
#
# It makes /home, /root and /run/user "inaccessible and empty", so the coordinator cannot read the
# bridge's bundle directory — and it fails SILENTLY, because can_serve_witness() probes with
# os.path.exists(), which simply returns False and falls through to the legacy per-block witness
# window. No exception, no log line. The co-located bundle read that lets provers request ARBITRARY
# heights would quietly stop working and look like nobody submitting (hazync#60).
#
# Verified 2026-08-02 on the live box: ProtectHome=no there, /api/witness/<n> returns 200, and the
# bundle dir holds 220,001 files. The bug was never live — it was latent in THIS file, waiting for
# someone to deploy it.
#
# Restore ProtectHome=true only after the bundle dir moves out of /root (hazync#58).
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/opt/hazync

[Install]
WantedBy=multi-user.target
