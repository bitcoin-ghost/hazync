target/
# Run logs are noise, EXCEPT the ones under prover/evidence/ — those are measurements we cite and must
# not lose. block_741000_proof.log survived only by being force-added; the ~9h block 962,000 run did not,
# and its numbers now exist solely in a Delving comment (#132, #133).
*.log
!prover/evidence/*.log
# prover/build-release.sh output (184-330MB binaries).
# NB: .gitignore has no trailing comments — a comment after the pattern becomes PART of the pattern.
# This line used to read `dist/    # ...` and therefore ignored nothing at all, leaving the release
# binaries one `git add -A` away from being committed.
dist/
bitcoin-core/
secp256k1/
__pycache__/
*.pyc

# libFuzzer corpus + crash artifacts: machine-generated and regenerated on demand (they were 1,160
# files / 4.6MB, i.e. 96% of the repo's file count). Meaningful inputs are curated in audit-fuzz/seeds/.
audit-fuzz/fuzz/corpus/
audit-fuzz/fuzz/artifacts/

# never commit prover identity / key material
.hazync/
*.hex
key.hex

# private launch-readiness roadmap (never push)
roadmap.md
bridge-design.md
README.reframe-draft.md
verifier/target/

# rescued box identities / key material — NEVER commit (see also key.hex above)
secrets/
verifier-ffi/target/
verifier-wasm/target/
verifier-wasm/*.wasm
